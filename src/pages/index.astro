---
// @level main
import "../../tokens.css";
// The identity pair (the PR mark above the stamp) comes from the one file the
// route page inlines, so the "Record generated" stamp and the "Rules read"
// stamp are the same drawing and cannot drift (human, 2026-09-08).
import "../../identity.css";
import rawDataset from "permit-rulebook-data/data/dataset.json";
import { assertValidDataset } from "permit-rulebook-data/validate";
import { datasetMeta, remainingQuestions } from "permit-rulebook-data";
// The first question is the same for everyone until an answer is given, so the
// build draws it — through the very code the interview draws every later
// screen with, never a second copy of the markup (s10, 2026-09-15).
// The question screens' masthead is drawn by the same function, server and
// client alike, so "Start over" cannot leave a stale claim on question 1
// (product-critique v0.7, B4).
import {
  declarationCount, declarationHtml, holdLineHtml, questionCardHtml, questionMastheadOf, renderStandInsOverQuestionOne,
} from "../lib/question.js";
// The three things the page must know about the reader before it paints, read
// in <head>, and the rules that paint the shape the interview would have
// chosen from them (s10, 2026-09-15).
import { FIRST_PAINT_SCRIPT, FIRST_PAINT_STYLE } from "../lib/first-paint.js";
// The seal, the icon links and the pair: one set of elements, four screens
// (Standards review, 2026-09-08).
import { stamps } from "../lib/identity.js";
// The frame's pieces, the policy among them, computed where node:crypto
// lives — never in the client bundle: the policy, the icon links, the header,
// the footer and the menu script every other page wears (#142).
import { interviewFrameOf } from "../lib/frame/framed-page.js";
// The product's own words, in one place: the name, the tagline and the
// disclaimer are said here, on 23 route pages and in both READMEs (decision 9).
import {
  HOME_DESCRIPTION, HOME_PREVIEW_TITLE, HOME_TITLE, promise, RULES_READ, TAGLINE,
} from "../lib/copy/frame.js";
import { START_OVER, YOU_DECLARED } from "../lib/copy/interview.js";
import { routeCounts } from "../lib/data-page.js";
import { analyticsBeacon, headMeta } from "../lib/site.js";

// Boundary validation: an invalid dataset must kill the build, loudly.
const dataset = assertValidDataset(rawDataset);
const meta = datasetMeta(dataset);
const intro = questionMastheadOf({ kind: "question", started: false });
/**
 * The masthead's other standing form: the promise shortens once it has been
 * read, and a reader with a record read it last time. Both are painted, and
 * the promise the pre-paint script seeds says which one this reader gets, so
 * nothing swaps the text after the first paint (s10).
 */
const started = questionMastheadOf({ kind: "question", started: true });
/**
 * The screen the page paints with, before any script runs: question one, with
 * nothing on the record. Every reader meets it, and the ones whose own screen
 * differs — a saved record, an arrival from a country or route page — have
 * theirs put in its place by the interview, in the same box.
 */
const firstQuestions = remainingQuestions(dataset, {});
const firstScreen = questionCardHtml({
  dataset, question: firstQuestions[0], answers: {}, asked: [], editing: null,
  total: firstQuestions.length,
});
const firstDeclaration = declarationHtml(dataset, { answers: {}, asked: [], currentField: firstQuestions[0].field });
/**
 * And, over it, the line for a reader whose own screen is not this one. The
 * card stays in the box under it, so the box is the same box, and a returning
 * reader is never shown a question they have already answered while the
 * interview loads (human's walk, 2026-09-15).
 */
const firstStandIns = renderStandInsOverQuestionOne();
/**
 * And, for the reader owed a verdict, the same sentence under the eyebrow:
 * their headline has no shape a stylesheet could reserve, so nothing below
 * the eyebrow is painted for them at all, and the line says where they are
 * while the interview draws (s31).
 */
const holdLine = holdLineHtml();
const frame = interviewFrameOf(dataset);
console.log(JSON.stringify({ level: "info", msg: "dataset valid at build boundary", ...meta }));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Fragment set:html={frame.policy} />
  <script is:inline set:html={FIRST_PAINT_SCRIPT}></script>
  <style is:inline set:html={FIRST_PAINT_STYLE}></style>
  <title>{HOME_TITLE}</title>
  <Fragment set:html={frame.icons} />
  <Fragment set:html={headMeta({
    title: HOME_PREVIEW_TITLE,
    description: HOME_DESCRIPTION,
    path: "/",
    kind: "website",
    preview: promise(routeCounts(dataset)),
  })} />
</head>
<body>
  <div class="wrap">
    <Fragment set:html={frame.header} />

    <header class="masthead-with-stamps">
      <div>
        <div class="brand">{TAGLINE}</div>
        <Fragment set:html={holdLine} />
        <h1 id="headline" set:html={intro.headline}></h1>
        <p class="sub" id="subline"><span class="standing-promise"><span class="sub-fresh">{intro.subline}</span><span class="sub-started">{started.subline}</span></span></p>
      </div>
      {/* One pair, two states. On the question screens it states the same
          fact the route page states — when the rules were last read — and on
          the results it becomes the record's own date (human, 2026-09-08).
          The box never moves: only the words and the date inside it change. */}
      <Fragment set:html={stamps(RULES_READ, meta.newest_retrieved_at ?? "", { live: true })} />
    </header>

    <div id="app" class="cols" data-state="questions">
      {/* The question comes first in the document. On a phone the single
          column then opens on the question instead of on the masthead, the
          intro and a growing ledger (product-critique v0.7, F8); on a wide
          screen the grid puts the ledger back on the left. */}
      <main id="main" set:html={firstScreen + firstStandIns}></main>
    <!--
      One live region for the whole screen, created empty and filled after the
      render that has something to say. A region inserted with its text already
      in it is not reliably announced, and a second one created inside a card
      dies with that card (Standards and Spec reviews, 2026-09-08).
    -->
    <p class="visually-hidden" id="cstatus" role="status" aria-live="polite"></p>
      <details class="decl" id="decl" open>
        <summary><span class="decl-title">{YOU_DECLARED}</span><span class="decl-count" id="decl-count">{declarationCount(0)}</span><span class="decl-set-aside-folded" id="decl-set-aside-folded"></span></summary>
        <dl id="decl-list" set:html={firstDeclaration}></dl>
        <div id="decl-set-aside"></div>
        <a class="edit" href="#" id="restart" hidden>{START_OVER}</a>
      </details>
    </div>

    <Fragment set:html={frame.footer} />
  </div>

  <!-- The header's menu, from the same source the generated pages inline. -->
  <script is:inline set:html={frame.menuScript}></script>

  <script>
    // The page's one job: build the interview's two ports and start it. The
    // interview, its drawing and its stylesheet are `lib/interview/`'s.
    import { browserHistoryOf } from "../lib/browser-history.js";
    import { startInterview, type InterviewPorts } from "../lib/interview/index.js";

    /**
     * The browser's own store, if it has one. Reading the property itself
     * throws where site data is blocked (private mode, blocked cookies); the
     * interview then works without surviving the tab, so the error is
     * dropped. What is kept, what is dropped and what "Start over" takes is
     * `record.ts`'s.
     */
    const store: InterviewPorts["store"] = (() => {
      try {
        return window.localStorage;
      } catch { return null; }
    })();

    startInterview({ browserHistory: browserHistoryOf(window), store });
  </script>
  <Fragment set:html={analyticsBeacon()} />
</body>
</html>
