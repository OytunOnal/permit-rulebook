---
import "../../tokens.css";
// The identity pair (the PR mark above the stamp) comes from the one file the
// route page inlines, so the "Record generated" stamp and the "Rules read"
// stamp are the same drawing and cannot drift (human, 2026-09-08).
import "../../identity.css";
import rawDataset from "permit-rulebook-data/data/dataset.json";
import { assertValidDataset } from "permit-rulebook-data/validate";
import { datasetMeta } from "permit-rulebook-data";
// The masthead is one function of which screen is showing, server and client
// alike — a second copy of the intro copy here is how "Start over" left a
// stale claim on question 1 (product-critique v0.7, B4).
import { mastheadFor } from "../lib/screen.js";
// The seal, the icon links and the pair: one set of elements, four screens
// (Standards review, 2026-09-08).
import { MENU_SCRIPT, iconLinks, siteFooter, siteHeader, stamps } from "../lib/identity.js";
// The policy is computed where node:crypto lives — never in the client bundle.
import { contentSecurityPolicy } from "../lib/csp.js";
// The four country pages, generated beside the route pages they list, and the
// four links the shared header carries (product critique B2; site map, 2026-09-08).
import { footerFacts, navCountries } from "../lib/country-page.js";
// The product's own words, in one place: the name, the tagline and the
// disclaimer are said here, on 23 route pages and in both READMEs (decision 9).
import { PRODUCT_NAME, promise, TAGLINE } from "../lib/copy.js";
import { routeCounts } from "../lib/data-page.js";
import { analyticsBeacon, headMeta } from "../lib/site.js";

// Boundary validation: an invalid dataset must kill the build, loudly.
const dataset = assertValidDataset(rawDataset);
const meta = datasetMeta(dataset);
const intro = mastheadFor({ kind: "question", started: false });
/** What a search result says about the interview. */
const INTRO_DESCRIPTION =
  "Which European work-permit routes fit? A check against dated, source-quoted "
  + "official rules. Your answers never leave this device.";
console.log(JSON.stringify({ level: "info", msg: "dataset valid at build boundary", ...meta }));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <Fragment set:html={contentSecurityPolicy([MENU_SCRIPT])} />
  <title>{PRODUCT_NAME} — which work-permit routes fit?</title>
  <Fragment set:html={iconLinks()} />
  <Fragment set:html={headMeta({
    title: `${PRODUCT_NAME} — ${TAGLINE.toLowerCase().replace(/\.$/, "")}`,
    description: INTRO_DESCRIPTION,
    path: "/",
    kind: "website",
    preview: promise(routeCounts(dataset)),
  })} />
</head>
<body>
  <div class="wrap">
    <Fragment set:html={siteHeader(navCountries(dataset))} />

    <header class="masthead-with-stamps">
      <div>
        <div class="brand">{TAGLINE}</div>
        <h1 id="headline" set:html={intro.headline}></h1>
        <p class="sub" id="subline">{intro.subline}</p>
      </div>
      {/* One pair, two states. On the question screens it states the same
          fact the route page states — when the rules were last read — and on
          the results it becomes the record's own date (human, 2026-09-08).
          The box never moves: only the words and the date inside it change. */}
      <Fragment set:html={stamps("Rules read", meta.newest_retrieved_at ?? "", { live: true })} />
    </header>

    <div id="app" class="cols" data-state="questions">
      {/* The question comes first in the document. On a phone the single
          column then opens on the question instead of on the masthead, the
          intro and a growing ledger (product-critique v0.7, F8); on a wide
          screen the grid puts the ledger back on the left. */}
      <main id="main"></main>
    <!--
      One live region for the whole screen, created empty and filled after the
      render that has something to say. A region inserted with its text already
      in it is not reliably announced, and a second one created inside a card
      dies with that card (Standards and Spec reviews, 2026-09-08).
    -->
    <p class="visually-hidden" id="cstatus" role="status" aria-live="polite"></p>
      <details class="decl" id="decl" open>
        <summary><span class="decl-title">You declared</span><span class="decl-count" id="decl-count"></span></summary>
        <dl id="decl-list"></dl>
        <a class="edit" href="#" id="restart" hidden>Start over</a>
      </details>
    </div>

    <Fragment set:html={siteFooter(navCountries(dataset), footerFacts(dataset))} />
  </div>

  <!-- The header's menu, from the same source the generated pages inline. -->
  <script is:inline set:html={MENU_SCRIPT}></script>

  <script>
    import dataset from "permit-rulebook-data/data/dataset.json";
    import {
      deriveQuestions, remainingQuestions, evaluate, formatEURPer,
      deriveBands, unlocks, notices, fieldOptions, matchOptions, referencedFields,
      // A route the authority closes to this reader's passport is not a
      // verdict the rules computed — one predicate, read by both repositories,
      // so a screen can never file it under a heading that promises it later.
      isClosed,
      countryClasses, datasetMeta, contradictionsIn,
      // s5d: every word a verdict says comes from here, beside the rules — the
      // page holds no field-id-to-label table of its own to fall through
      // (product-critique v0.7, B3).
      shortLabelOf, unlockTitleOf, declaredPlace, liveUnknowns, isPlacedElsewhere, mootWith, joinOr,
      // What an answer means here, where the label alone leaves two answers
      // hard to tell apart (human walk, 2026-09-08).
      optionMeans, unlockMeansOf, countryPhrase,
      type Dataset, type FieldOption, type Profile, type RouteResult,
    } from "permit-rulebook-data";
    import { routePath } from "../lib/slug.js";
    // Every internal URL the client writes goes through the same helper the
    // server side uses, or the site breaks under a subpath (2026-09-08).
    import { url } from "../lib/site.js";
    // Arriving from a route page's call to action: what goes on the record and
    // what sorts first, beside the page rather than inside it (step 10).
    import {
      arrivalFrom, arrivalPlan, arrivalSentence, countryArrivalFrom, destinationFor,
      destinationForCountry, replayRecord, scopedFirst,
      type ScopedArrival,
    } from "../lib/scope.js";
    // A symbol a stranger cannot read is explained the first time a screen uses
    // it, by the same module the route pages use (human, 2026-09-08).
    import { type Glossary, glossSection } from "../lib/gloss.js";
    import { activeOption, onKey, rowId, shownOptions, stateFor, type ListboxKey, type ListboxState } from "../lib/listbox.js";
    import {
      clampStep, emptyHistory, historyFor, mastheadFor, recordScreen as recordEntry, screenAfter,
      screenAt, type Explore, type FlowAction,
    } from "../lib/screen.js";
    import { clearRecord, loadRecord as readRecord, saveRecord as writeRecord, type RecordStore } from "../lib/record.js";
    // The reason column's markup, beside the page rather than in it, so what
    // it renders can be read by a test (review S4).
    import { esc, escAttr, failDetailHtml, whyHtml } from "../lib/reason.js";
    // One date format, everywhere a date prints (decision 12).
    import { isoDay } from "../lib/copy.js";
    import {
      carveOutHtml, caveatHtml, closedRowHtml, noticeHtml, precondHtml, provenanceHtml, railHtml,
      readingHtml, scopedHtml,
      measuredCriterionOf,
    } from "../lib/card.js";

    const ds = dataset as unknown as Dataset;
    // One field-lookup idiom for the whole page: the dataset never changes
    // after load, and six copies of the same scan drift (review).
    const fieldById = new Map(ds.fields.map((f) => [f.id, f]));
    const fieldOf = (id: string) => fieldById.get(id);
    const questions = deriveQuestions(ds);
    const main = document.getElementById("main")!;
    const decl = document.getElementById("decl") as HTMLDetailsElement;
    const declList = document.getElementById("decl-list")!;
    const restart = document.getElementById("restart")!;
    const headline = document.getElementById("headline")!;
    const subline = document.getElementById("subline")!;
    const app = document.getElementById("app")!;

    /**
     * The stamp says which fact the screen is standing on.
     *
     * On the questions it is the dataset's own newest read date — the same
     * sentence a route page carries, and a true thing to say before anyone has
     * answered anything. On the results it is the day this record was made. It
     * stayed hidden until the results until 2026-09-08, which left the masthead
     * lopsided on the one screen every reader sees first.
     */
    const stampLabel = document.getElementById("stamp-label")!;
    const stampDate = document.getElementById("stamp-date")!;
    const stampTime = document.getElementById("stamp-time")!;
    const rulesRead = datasetMeta(ds).newest_retrieved_at ?? "";

    function setStamp(kind: "rules-read" | "record") {
      const record = kind === "record";
      stampLabel.textContent = record ? "Record generated" : "Rules read";
      const day = record ? isoDay(new Date()) : rulesRead;
      stampDate.textContent = day;
      stampTime.setAttribute("datetime", day);
    }
    // ISO, like every other date the product prints (s6 decision 12). It read
    // `07 · 09 · 2026` until this slice — a second format on a screen whose
    // whole differentiator is when a thing was read, and ambiguous to exactly
    // the reader most likely to be reading it (route-page critique F3). Local
    // time, not UTC: the stamp is the day the person in front of it is having.
    setStamp("rules-read");

    const STATUS_LABEL = { met: "Criteria met", near: "Within reach", hold: "Not yet" } as const;
    const declCount = document.getElementById("decl-count")!;

    let answers: Profile = {};
    let asked: string[] = []; // answered fields, in order, for Back
    /** The field being reconsidered — from the declaration panel or from Back.
     * The answer is never deleted while it is on screen: it renders as the
     * selected option, and picking another replaces it. */
    let editing: string | null = null;

    /** What the country picker just put on the record. The control commits a
     * row that need not be the text in the box, so the commit is stated in
     * words on the next screen — the side ledger was the only feedback, and a
     * whole record was computed for the wrong nationality in silence
     * (product-critique v0.7, B1). */
    let justRecorded: { field: string; label: string } | null = null;

    /**
     * The route a reader arrived from, when the call to action on a route page
     * sent them here (`/?route=de-blue-card-general`).
     *
     * It does two things and no more: the destination goes on the record, so
     * the interview starts where the reader already is, and that route sorts
     * first in its own group when the results come. It never overrides an
     * answer the person gave — a link is not louder than a declaration — so a
     * stored record with a destination in it is left exactly as it stands.
     */
    let scopedRouteId: string | null = null;
    let cameFrom: ScopedArrival | null = null;
    /** The country an arrival named, when it named one without a route. */
    let cameFromCountry: string | null = null;
    /** Whether this arrival is what put the destination on the record. */
    let scopeRecorded = false;
    /** What survived the arrival, and how many questions this country still
     * has — the two facts the arrival line is allowed to state. */
    let arrivalKept: string[] = [];
    let arrivalAsks = 0;
    /** The country the record named before this arrival moved it, if any. */
    let rescopedFrom: string | null = null;

    /**
     * Land the reader where the link says they are.
     *
     * The country on the link replaces the destination on the record and
     * everything else they told us is kept, because a reader standing on
     * France's page pressing France's own button is asking about France —
     * whatever they asked yesterday. Money answers travel through the engine's
     * own translation between ladders, and one it cannot read is asked again
     * rather than guessed (isolated v1-gate critique, 2026-09-08, B2).
     */
    function scopeFromLink() {
      cameFrom = arrivalFrom(ds, location.search);
      const country = cameFrom ? cameFrom.country : countryArrivalFrom(ds, location.search);
      const destination = cameFrom
        ? destinationFor(cameFrom)
        : destinationForCountry(country);
      if (cameFrom) scopedRouteId = cameFrom.route.id;
      if (destination === null || !country) return;
      // The country's own prose form: a sentence says "the Netherlands", the
      // button in the nav says "Netherlands" (the same rule `declaredPlace`
      // follows for every other sentence naming a place).
      cameFromCountry = countryPhrase(country.code.toUpperCase()) ?? country.name;
      const before = answers["destination"];
      rescopedFrom = before !== undefined && before !== destination ? before : null;
      const plan = arrivalPlan(ds, answers, asked, destination);
      // Nothing moved: the reader is already here, and a line saying so is a
      // line about nothing (Spec review, 2026-09-08).
      if (!plan.changed) return;
      answers = plan.answers;
      asked = plan.order;
      arrivalKept = plan.kept;
      arrivalAsks = plan.asks;
      scopeRecorded = true;
      saveRecord();
    }

    /**
     * What the arrival did, in one line, on whichever screen the reader lands
     * on.
     *
     * The route path narrated itself and the country path did not (critique
     * F15), and neither said anything at all to a reader with a record — who
     * is exactly the reader whose screen just changed country (B2). Where an
     * answer could not travel to the new ladder, the line says which question
     * is coming back rather than letting it reappear unexplained.
     */
    function arrivalLine(): string {
      if (!scopeRecorded || (!cameFrom && !cameFromCountry)) return "";
      const what = cameFrom ? routeName(cameFrom) : cameFromCountry!;
      const place = cameFrom
        ? (countryPhrase(cameFrom.country.code.toUpperCase()) ?? cameFrom.country.name)
        : cameFromCountry!;
      // The words are built where they can be read by a test, over every
      // question that can come back: the label lower-cased here turned "IT
      // work" into "it work" on the live site (human re-read, 2026-09-08).
      return `<p class="recorded" role="status">${
        esc(arrivalSentence(ds, {
          from: what, place, rescoped: rescopedFrom !== null,
          kept: arrivalKept, asks: arrivalAsks,
        }))
      }</p>`;
    }

    /**
     * Say something once, in the screen's own live region.
     *
     * Written after the render, never inside it: a region that arrives with its
     * text already in place is not announced by every screen reader, and the
     * interview's own status line proved the pattern works.
     */
    function announce(text: string): void {
      const region = document.getElementById("cstatus");
      if (region) region.textContent = text;
    }

    /** One masthead, one writer. Every gesture names itself, and only the two
     * that compare something can produce a screen that says so — no path back
     * into the interview ("Start over", an edit, browser Back) can leave a
     * claim about a comparison standing (product-critique v0.7, B4). The
     * transitions themselves live in `screen.ts`, where a property test walks
     * them in every order (review H1). */
    function advance(action: FlowAction) {
      const m = mastheadFor(screenAfter(action, { answered: asked.length }));
      headline.innerHTML = m.headline;
      subline.textContent = m.subline;
    }

    /** A field's answer set. Some fields declare their options by reference
     * (the country list lives in its own file), so the engine's own accessor is
     * the single place the page reads them — the derived question would hand
     * back band pseudo-options for money fields (review). */
    const optionsOf = (field: string): FieldOption[] => fieldOptions(ds, field);

    // s5c: above a dozen options the question becomes a filter over a list
    // instead of a wall of buttons; at or below a dozen, nothing changes.
    const LONG_LIST_ABOVE = 12;

    /** What an option's class reads as beside it. Derived from the dataset —
     * the class the option implies, or the fact that a notice would fire on
     * this answer — never a string keyed to one country. */
    function classHint(field: string, o: FieldOption): string {
      // A notice that adds rights says so in its own title; naming one treaty
      // here would print the wrong one for the next agreement (review).
      const extra = notices(ds, { [field]: o.value }).find((n) => n.kind === "extra-rights");
      if (extra) return "a note applies to this passport";
      const cls = o.implies?.[0];
      return cls ? (countryClasses[cls]?.label ?? cls) : "";
    }

    // The ledger grows as the record accrues: answered rows accumulate and
    // only the question currently on the table shows as a pending row. With
    // adaptive pruning, fields that never get asked never appear — the panel
    // promises nothing it won't deliver.
    /**
     * One screen, one memory of which abbreviations it has already expanded —
     * the route page's rule, on a page that repaints instead of reloading. A
     * route's name is where most readers meet "§": it is in the name of every
     * German route (human walk, 2026-09-08).
     */
    let glossary: Glossary = new Set();
    const routeName = (r: { route: { name: string } }): string => glossSection(r.route.name, glossary);

    function renderDeclaration(currentField: string | null) {
      // Rows in the order they were asked; the pending row appends last.
      // Answered rows are edit points: clicking one resumes the interview at
      // that question, keeping everything before it (a full reset destroyed
      // every answer — human catch, golden G3).
      const fields = currentField && !asked.includes(currentField)
        ? [...asked, currentField]
        : asked;
      declList.innerHTML = fields.map((f) => {
        const opt = optionsOf(f).find((o) => o.value === answers[f]) ??
          deriveBands(ds, f).find((b) => b.id === answers[f]);
        return opt
          ? `<div class="done" data-field="${escAttr(f)}" role="button" tabindex="0" title="Change this answer"><dt>${esc(shortLabelOf(ds, f))}</dt><dd>${esc(opt.label)} <span class="pen" aria-hidden="true">✎</span></dd></div>`
          : `<div><dt>${esc(shortLabelOf(ds, f))}</dt><dd class="pending">—</dd></div>`;
      }).join("");
      declList.querySelectorAll<HTMLElement>("[data-field]").forEach((row) => {
        const jump = () => {
          const f = row.dataset.field!;
          if (asked.indexOf(f) < 0) return;
          editing = f;
          setStamp("rules-read");
          app.dataset.state = "questions";
          renderQuestion({ kind: "edit" });
        };
        row.addEventListener("click", jump);
        row.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); jump(); } });
      });
      // On a phone the ledger collapses to this one line; on a wide screen the
      // summary is hidden and the panel is always open.
      declCount.textContent = asked.length
        ? `${asked.length} answer${asked.length === 1 ? "" : "s"} — tap to review or change`
        : "nothing yet";
      restart.hidden = currentField !== null;
    }

    /**
     * Replay the stored answers through the interview and keep the ones it
     * still asks for. Changing "destination: Netherlands" to "Germany" drops
     * the Dutch-only answers because the flow no longer reaches them; it does
     * not drop citizenship, age or salary, which it still does. Anything the
     * interview would not ask is silently forgotten rather than shown as a
     * stale row (human catch: editing question 2 re-asked everything after it).
     */
    function replayAnswers() {
      const replayed = replayRecord(ds, answers, asked);
      answers = replayed.answers;
      asked = replayed.order;
    }

    /** Draw the question screen the gesture lands on. Rendering and advancing
     * the masthead are one call, so a path back into the interview cannot
     * render without saying which gesture brought it here (B4). */
    function renderQuestion(action: FlowAction) {
      glossary = new Set();
      // Only questions a still-alive route cares about; e.g. "no job offer"
      // retires the salary question instead of asking it into the void.
      const remaining = remainingQuestions(ds, answers);
      if (!editing && remaining.length === 0) return renderResults();
      const q = editing
        ? (remaining.find((x) => x.field === editing) ?? questions.find((x) => x.field === editing)!)
        : remaining[0];
      advance(action);
      announce("");
      renderDeclaration(q.field);
      const total = asked.length + remaining.length;
      const answer = (value: string) => {
        answers[q.field] = value;
        if (editing) {
          // The edited answer keeps its place in the order; everything after it
          // survives unless the flow no longer asks it.
          editing = null;
          replayAnswers();
        } else {
          asked.push(q.field);
        }
        saveRecord();
        renderQuestion({ kind: "answer" });
      };
      // A list this long is a search, not a choice between buttons — but it is
      // still a choice from the dataset's own options: no free text, no
      // guessing at spellings.
      const longList = q.options.length > LONG_LIST_ABOVE;
      const classed = q.options.some((o) => o.implies !== undefined);
      const declared = q.options.find((o) => o.value === answers[q.field]);
      main.innerHTML = `
        <section class="qcard">
          ${arrivalLine()}
          ${justRecorded ? `<p class="recorded" role="status">${esc(shortLabelOf(ds, justRecorded.field))} recorded: <b>${esc(justRecorded.label)}</b></p>` : ""}
          <div class="qmeta" role="status" aria-live="polite">${
            editing ? "Your answer — pick another to change it, the rest are kept" : `Question ${asked.length + 1} of up to ${total}`
          }</div>
          <h2 class="qlabel">${esc(q.label)}</h2>
          ${(() => {
            // Where the answer is a thing a person can look up, the way to look
            // it up belongs at the question, not three screens later on a
            // result card that already assumed an answer (isolated v1-gate
            // critique, 2026-09-08, F13). It is the dataset's own link — the
            // same one the card and the route page show.
            const learn = fieldOf(q.field)?.learn;
            return learn
              ? `<p class="qlearn">Not sure? <a href="${escAttr(learn.url)}" target="_blank" rel="noopener">${
                esc(glossSection(learn.label, glossary))}</a></p>`
              : "";
          })()}
          ${longList ? `
            <div class="csearch">
              <span class="mag" aria-hidden="true">⌕</span>
              <input type="text" id="cfilter" autocomplete="off" spellcheck="false"
                role="combobox" aria-expanded="false" aria-autocomplete="list"
                aria-label="Search the list" aria-controls="clist" placeholder="Start typing…"
                value="${escAttr(declared?.label ?? "")}">
            </div>
            <div class="clist" id="clist" role="listbox" aria-label="${escAttr(q.label)}"></div>
            <p class="recorded" id="crecorded"${declared ? "" : " hidden"}>Your answer on file: <b>${esc(declared?.label ?? "")}</b></p>
            ${classed ? `<p class="hint">Every non-EU passport is checked against the same rules. A few countries
              have agreements that add rights on top — those are stated with their source when they apply to you.</p>` : ""}`
          : `<div class="opts">
            ${q.options.map((o) => {
              const chosen = answers[q.field] === o.value;
              // A reader whose employer was moving them to a branch abroad read
              // "a job offer there" as their situation and took a route as open
              // that is not (human walk, 2026-09-08). Where an answer says what
              // it means, it says it here — under the answer, not in a hint at
              // the foot of the question nobody reads before choosing.
              const means = optionMeans(o, ds, answers);
              return `<button class="opt${chosen ? " sel" : ""}" data-value="${escAttr(o.value)}"${
                chosen ? ` aria-pressed="true"` : ""}><span class="opt-label">${esc(o.label)}${
                chosen ? `<span class="tick" aria-hidden="true">✓</span>` : ""}</span>${
                means ? `<small class="opt-means">${esc(means)}</small>` : ""}</button>`;
            }).join("")}
          </div>`}
          ${(editing ? asked.indexOf(editing) > 0 : asked.length > 0)
            ? `<button class="back" id="back">← Back</button>` : ""}
          ${editing ? `<button class="back" id="done">Keep this answer</button>` : ""}
        </section>`;

      if (longList) {
        const filter = document.getElementById("cfilter") as HTMLInputElement;
        const list = document.getElementById("clist")!;
        const recorded = document.getElementById("crecorded")!;
        // The control's selection semantics live in one pure model, and the DOM
        // is only its picture: what Enter commits is decided there, where a
        // property test can hold it (product-critique v0.7, B1).
        let box: ListboxState = stateFor(filter.value);
        const draw = () => {
          filter.setAttribute("aria-expanded", String(box.open && box.query.trim() !== ""));
          const status = document.getElementById("cstatus");
          if (!box.query.trim() || !box.open) {
            // Before aliases existed the cold list was the only escape hatch
            // for someone who could not spell the official name; now typing
            // finds them, so opening on sixty rows is just noise (tracker #4).
            list.innerHTML = `<p class="cnone">${q.options.length} countries — the name you grew up with works too.</p>`;
            filter.removeAttribute("aria-activedescendant");
            if (status) status.textContent = "";
            return;
          }
          const matches = matchOptions(q.options, box.query);
          if (!matches.length) {
            // An empty box says nothing; this says what to do about it.
            list.innerHTML = `<p class="cnone">No country matches. Try fewer letters, or the country's own name.</p>`;
            filter.removeAttribute("aria-activedescendant");
            if (status) status.textContent = "No country matches";
            return;
          }
          const shown = shownOptions(q.options, box);
          const active = activeOption(q.options, box);
          if (status)
            status.textContent = `${matches.length} match${matches.length === 1 ? "" : "es"}` +
              (active ? `. ${active.label} highlighted — press Enter to record it` : "");
          list.innerHTML = shown.map((o, i) => {
            const chosen = answers[q.field] === o.value;
            return `<button class="copt${i === box.active ? " on" : ""}${chosen ? " sel" : ""}" role="option" id="${escAttr(rowId(i))}"
              aria-selected="${escAttr(String(i === box.active))}" data-value="${escAttr(o.value)}"><span>${esc(o.label)}${
              chosen ? ` <span class="tick" aria-hidden="true">✓</span>` : ""}</span>${
              classed ? `<span class="cls">${esc(classHint(q.field, o))}</span>` : ""}</button>`;
          }).join("") +
            (matches.length > shown.length
              ? `<p class="cmore">${matches.length - shown.length} more — keep typing to narrow the list</p>`
              : "");
          if (box.active >= 0) filter.setAttribute("aria-activedescendant", rowId(box.active));
          else filter.removeAttribute("aria-activedescendant");
          list.querySelector<HTMLElement>(".copt.on")?.scrollIntoView({ block: "nearest" });
          list.querySelectorAll<HTMLButtonElement>(".copt").forEach((b) =>
            b.addEventListener("click", () => {
              const chosen = q.options.find((o) => o.value === b.dataset.value);
              if (chosen) justRecorded = { field: q.field, label: chosen.label };
              answer(b.dataset.value!);
            }));
        };
        filter.addEventListener("input", () => { box = stateFor(filter.value); draw(); });
        filter.addEventListener("keydown", (e) => {
          // isComposing: an IME's committing Enter belongs to the IME.
          if (e.isComposing) return;
          const keys = ["ArrowDown", "ArrowUp", "Home", "End", "Enter", "Escape"];
          if (!keys.includes(e.key)) return;
          // Home/End inside a text box move the caret; claim them only once a
          // row is highlighted, so typing still behaves like typing.
          if ((e.key === "Home" || e.key === "End") && box.active < 0) return;
          e.preventDefault();
          const result = onKey(q.options, box, e.key as ListboxKey);
          box = result.state;
          if (result.commit) {
            // Say what was recorded, in the question card — the side ledger is
            // not where a person looks after pressing Enter.
            recorded.innerHTML = `Recorded: <b>${esc(result.commit.label)}</b>`;
            recorded.hidden = false;
            justRecorded = { field: q.field, label: result.commit.label };
            answer(result.commit.value);
            return;
          }
          draw();
        });
        draw();
        filter.focus();
        // A correction starts by replacing, not by prepending: the caret sat at
        // position 0 and the first keystroke produced "nigeriaNiger"
        // (product-critique v0.7, F3).
        filter.select();
      } else {
        main.querySelectorAll<HTMLButtonElement>(".opt").forEach((btn) =>
          btn.addEventListener("click", () => answer(btn.dataset.value!)));
      }
      // Shown once, on the screen straight after the commit.
      justRecorded = null;
      // The same rule for the line that says where the reader came from.
      cameFrom = null;
      scopeRecorded = false;

      document.getElementById("done")?.addEventListener("click", () => {
        editing = null;
        renderQuestion({ kind: "answer" });
      });
      document.getElementById("back")?.addEventListener("click", () => {
        // The screen's Back and the phone's Back are one gesture, so they can
        // never land on different screens (human, 2026-09-08): this asks the
        // browser to go back, and the popstate handler shows the question that
        // entry was showing. Nothing is erased on the way.
        if (screens.current > 0) { window.history.back(); return; }
        // Standing on our first entry: there is nothing of ours behind, so the
        // step is the one editing a declared row makes.
        const at = editing ? asked.indexOf(editing) : asked.length;
        const prev = asked[at - 1];
        if (prev === undefined) return;
        editing = prev;
        setStamp("rules-read");
        app.dataset.state = "questions";
        renderQuestion({ kind: "edit" });
      });

      // One entry per question screen: answering moves forward, everything
      // else — editing, restoring, starting over — stands where it is.
      recordScreen(q.field, action.kind === "answer");
    }


    type CritResult = RouteResult["criteria"][number];

    /** Unknowns the user can still act on. Every consumer (verdict line, strip
     * count, auto-open, learn box) reads this one list, or they contradict each
     * other on the same row (review). */
    const openUnknownsOf = (r: RouteResult) => liveUnknowns(r, answers);
    const hasLiveUnknown = (r: RouteResult) => openUnknownsOf(r).length > 0;


    /** Why this route reads the way it does — a sentence, from the engine.
     * The page used to compose this itself out of field names, which is how
     * "Not met: situation" became the verdict on 22 of 23 cards
     * (product-critique v0.7, B3). */
    const whyFor = (r: RouteResult): string => whyHtml(ds, r, answers);
    /** Conditions the authority applies that the interview never asked —
     * stated on every card so "criteria met" cannot overpromise. Both blocks
     * are rendered beside the page (lib/card.ts) so a test can read them. */
    const precondFor = (r: RouteResult): string => precondHtml(r.route, answers);
    /** What the authority itself says is off this reader, in place of the
     * condition it releases them from. A carve-out carries its own quote and
     * is never printed under a heading that means "you must also do this"
     * (s7). */
    const carveOutFor = (r: RouteResult): string => carveOutHtml(r.route, answers);
    /** What the source says its own answer does not settle. Never a failure —
     * and never under the "Also required" heading, which would turn "you may
     * qualify for less" into one more bar to clear (human catch 2026-09-07). */
    const caveatFor = (r: RouteResult): string => caveatHtml(r.route, answers);
    /** Our own reading — what we modelled, what we did not, and where a number
     * was read by a person. Never presented as an authority's words, and never
     * in the quote list (s5e). */
    const readingFor = (r: RouteResult): string => readingHtml(r.route);
    /** The rail, labelled with the threshold this result was measured
     * against — the path that was met, or the nearest reachable one. */
    const railFor = (r: RouteResult): string => railHtml(ds, r, answers);
    /** Every value the route rests on, quoted, dated, and — where the route
     * states more than one threshold — marked with which one applied. */
    const provenanceFor = (r: RouteResult): string => provenanceHtml(ds, r, answers);


    // s3: "I don't know" answers get an official find-out link — driven by the
    // dataset's field `learn` sources, never hardcoded in the UI.
    function learnBoxFor(r: RouteResult): string {
      // Only where the unknown still binds: on a hard-failed route (wrong
      // qualification, no offer) finding out changes nothing, and the link
      // sends the user down a path that cannot open (critique #4).
      const links = openUnknownsOf(r)
        .map((f) => fieldOf(f)?.learn)
        .filter((l): l is { label: string; url: string } => !!l);
      if (!links.length) return "";
      // The same first use, on the same screen's memory: this help carries
      // "§ 18g AufenthG", and a screen explains a symbol once (Spec review,
      // 2026-09-08).
      return `<div class="learn">You can find out yourself: ${links
        .map((l) => `<a href="${escAttr(l.url)}" target="_blank" rel="noopener">${
          esc(glossSection(l.label, glossary))}</a>`)
        .join(" · ")}.</div>`;
    }

    const periodOf = (field: string) => fieldOf(field)?.period;

    /** The money field a route's bounded gap is measured on — its period is
     * what makes "€1,585" readable as monthly or annual (critique #7). */
    const gapFieldOf = (r: RouteResult) => measuredCriterionOf(ds, r, answers)?.field ?? "";

    /** One gap, one format, everywhere it is printed (card, headline, unlock). */
    const gapAmount = (r: RouteResult) =>
      formatEURPer(Math.round(r.gap_max!), periodOf(gapFieldOf(r)));

    // Expanded hold rows: one sentence per failing criterion, so a one-line
    // reason always unfolds into something concrete. The sentences come from
    // the engine — the page no longer names fields (B3).
    const failDetail = (r: RouteResult): string => failDetailHtml(ds, r, answers);

    /**
     * What the interview asks of this route, in the plain words the route page
     * shows, and the door to the page itself. It is the same declared fact in
     * both places: "fully modelled" was a badge that overclaimed and retracted
     * itself two sentences later (route-page critique B3), and a value said one
     * way here and another way there is two facts.
     */
    function scopeFor(r: RouteResult): string {
      const country = ds.countries.find((c) => c.code === r.country);
      if (!country) return "";
      // The reader's words, the same ones the country index and the route page
      // print (decision 3 amended by the human, 2026-09-08) — counted over the
      // conditions that bind THIS reader, beside the page so a test can read
      // the line (s7).
      return scopedHtml(r.route, answers, url(routePath(country, r.route)));
    }

    /**
     * Bring the marked card into view, opening whatever it is folded inside.
     *
     * Landing "somewhere on the results page" is what the route pages' one
     * call to action did for a returning reader (B2): the card was there, three
     * screens down, inside a collapsed group.
     */
    function showArrival(): void {
      const card = main.querySelector<HTMLElement>("[data-came-from]");
      if (!card) return;
      for (let node: HTMLElement | null = card; node; node = node.parentElement)
        if (node instanceof HTMLDetailsElement) node.open = true;
      // Instant, not smooth: a reader who arrives mid-scroll on a phone should
      // not watch the page travel.
      card.scrollIntoView({ block: "start" });
    }

    /**
     * The route the reader arrived from, marked and findable.
     *
     * "Check yours" from a route page landed on the whole results page with
     * that route buried inside a collapsed group and nothing scrolled to
     * (isolated v1-gate critique, 2026-09-08, B2). The mark is on the card
     * itself, so whichever group it lands in — open, within reach or not yet
     * — it is the same card the reader was reading a moment ago.
     */
    const cameFromMark = (r: RouteResult): string =>
      r.route.id === scopedRouteId ? ` data-came-from="${escAttr(r.route.id)}"` : "";

    /** The line inside the marked card, in the reader's own trail of thought. */
    const cameFromNote = (r: RouteResult): string =>
      r.route.id === scopedRouteId
        ? `<p class="from-here">The route you came from.</p>`
        : "";

    function fullCard(r: RouteResult, showCountry = true, unsettled = false): string {
      return `
        <article class="route"${cameFromMark(r)}>
          <div class="top">
            <div>${showCountry ? `<span class="country">${esc(ds.countries.find((c) => c.code === r.country)?.name ?? r.country)}</span>` : ""}
              <h3>${esc(routeName(r))}</h3></div>
            <span class="st ${unsettled ? "unsettled" : r.status}">${unsettled ? "Rules met" : STATUS_LABEL[r.status]}</span>
          </div>
          ${cameFromNote(r)}
          <p class="why">${whyFor(r)}</p>
          ${scopeFor(r)}
          ${precondFor(r)}
          ${carveOutFor(r)}
          ${caveatFor(r)}
          ${readingFor(r)}
          ${r.points ? `<div class="ptsline"><b>${r.points.scored} point${r.points.scored === 1 ? "" : "s"} — ${r.points.required} needed</b>${
            r.points.items.length ? " · " + r.points.items.map((i) => `${esc(shortLabelOf(ds, i.field))} +${i.points}`).join(" · ") : ""
          }</div>` : ""}
          ${r.status !== "hold" ? railFor(r) : ""}
          ${r.status === "near" && r.gap_max ? (() => {
            const gapField = gapFieldOf(r);
            const hint = gapField === "salary_eur_year"
              ? " A route with a lower threshold may already apply — check the other cards."
              : "";
            const label = gapField ? ` on ${esc(shortLabelOf(ds, gapField).toLowerCase())}` : "";
            return `<div class="gapnote"><b>Short by up to ${gapAmount(r)}</b>${label}.${hint}</div>`;
          })() : ""}
          ${r.status === "near" && r.gap_points ? `<div class="gapnote"><b>Short by ${r.gap_points} point${r.gap_points === 1 ? "" : "s"}.</b> The sourced points table shows where more can come from — language level, experience and age all score.</div>` : ""}
          ${learnBoxFor(r)}
          <div class="foot">${provenanceFor(r)}<a class="next" href="${escAttr(r.route.info_url)}" target="_blank" rel="noopener">Official page</a></div>
        </article>`;
    }

    function holdRow(r: RouteResult): string {
      const why = whyFor(r);
      const short = why.split(". ")[0].replace(/\.$/, "");
      // Auto-open only where the unknown still binds — a row opened on a dead
      // route promises an answer that cannot change it (critique #4).
      return `
        <details class="route-hold"${cameFromMark(r)}${hasLiveUnknown(r) || r.route.id === scopedRouteId ? " open" : ""}>
          <summary><span class="country">${esc(r.country)}</span><span class="hold-name">${esc(routeName(r))}</span><span class="hold-why">${short}</span></summary>
          <div class="hold-body">
            ${cameFromNote(r)}
            ${r.route.summary ? `<p class="why">${esc(r.route.summary)}</p>` : ""}
            ${scopeFor(r)}
            ${precondFor(r)}
            ${carveOutFor(r)}
            ${caveatFor(r)}
          ${readingFor(r)}
            ${failDetail(r)}
            ${learnBoxFor(r)}
            <div class="foot">${provenanceFor(r)}<a class="next" href="${escAttr(r.route.info_url)}" target="_blank" rel="noopener">Official page</a></div>
          </div>
        </details>`;
    }

    /** Every failing criterion of this row sits on a step the user hasn't
     * taken (an offer, a transfer, a hosting agreement) and nothing else is
     * open on it — the row says only what the step above already says. */
    /** Which rows a hold list collapses. `isLocalization`, `declaredPlace` and
     * `isPlacedElsewhere` are the engine's — one definition, so a row's reason
     * and its grouping can never disagree. */
    const placedElsewhere = (r: RouteResult) => isPlacedElsewhere(r, answers);
    const place = () => declaredPlace(ds, answers);

    /** A moot criterion: the route wants the "none of these" answer and the
     * person declared a real step, so they "failed" it by having MORE. The
     * shape is the engine's — the page re-derived it, and a second definition
     * of the same thing can disagree with the reason it prints (review S5). */
    const isMoot = (cr: CritResult): boolean => mootWith(ds, cr, answers) !== null;

    function isStepGated(r: RouteResult): boolean {
      const fails = r.criteria.filter((c) => c.outcome === "fail");
      if (!fails.length || hasLiveUnknown(r)) return false;
      // "Not needed with a job offer" is the opposite story — never file a
      // route whose criterion is moot under "needs a job offer".
      if (fails.some(isMoot)) return false;
      return fails.every((cr) => {
        const fields = referencedFields(cr.criterion);
        // A criterion referencing no field is not "path-gated" — engine parity.
        return fields.length > 0 && fields.every((f) => fieldOf(f)?.kind === "path");
      });
    }

    /** The steps a set of gated rows actually asks for, named by the dataset.
     * Fixed copy ("a job offer, transfer or hosting agreement") told a user who
     * had declared a transfer that they needed one (review). */
    function stepNamesFor(rows: RouteResult[]): string[] {
      const names = new Set<string>();
      for (const r of rows)
        for (const cr of r.criteria.filter((c) => c.outcome === "fail")) {
          const c = cr.criterion;
          if (!("field" in c)) continue;
          const def = fieldOf(c.field);
          if (def?.kind !== "path") continue;
          const wanted = c.op === "eq" ? [c.value] : c.op === "in" ? c.values : [];
          for (const v of wanted) {
            const opt = optionsOf(c.field).find((o) => o.value === v);
            if (opt && !opt.is_fallback) names.add(opt.short ?? opt.label);
          }
        }
      return [...names];
    }

    /**
     * One "needs a job offer" row per country was information; sixteen were
     * noise (critique #5). Rows gated on the step alone collapse into one
     * group; anything with its own reason keeps its own row.
     */
    function holdList(rows: RouteResult[], hasUnlocks: boolean): string {
      const gated: RouteResult[] = [], elsewhere: RouteResult[] = [], individual: RouteResult[] = [];
      for (const r of rows)
        (placedElsewhere(r) ? elsewhere : isStepGated(r) ? gated : individual).push(r);

      // Routes that are simply in another country collapse into one line: a
      // wall of "this route is Spain" answers a question the reader never
      // asked, on a fact they gave us themselves.
      const told = place();
      const elsewhereCountry = elsewhere.length
        ? (ds.countries.find((c) => c.code === elsewhere[0].country)?.name ?? elsewhere[0].country)
        : "";
      const elsewhereGroup = elsewhere.length >= 2
        ? `<details class="hold-group">
            <summary>${elsewhere.length} ${esc(elsewhereCountry)} routes — ${
              told ? `you told us ${esc(told)}` : "not where you are looking"}</summary>
            <div class="hold-group-body">${elsewhere.map(holdRow).join("")}</div>
          </details>`
        : elsewhere.map(holdRow).join("");

      if (gated.length < 3)
        return individual.map(holdRow).join("") + gated.map(holdRow).join("") + elsewhereGroup;
      const steps = joinOr(stepNamesFor(gated));
      // Open when it is the only thing on screen: a collapsed group was the
      // whole result for the emptiest profile, and every quote and read date
      // the product exists to show was folded away inside it (F7).
      const alone = individual.length === 0 && elsewhere.length === 0 && !hasUnlocks;
      return individual.map(holdRow).join("") +
        `<details class="hold-group"${alone ? " open" : ""}>
          <summary>${gated.length} routes need ${esc(steps)}${
            hasUnlocks ? " — see the steps above" : ""}</summary>
          <div class="hold-group-body">${gated.map(holdRow).join("")}</div>
        </details>` + elsewhereGroup;
    }

    function unlockCard(u: ReturnType<typeof unlocks>[number], routes: RouteResult[]): string {
      return `
        <article class="unlock">
          <h3>With <b>${esc(unlockTitleOf(ds, u, answers))}</b></h3>
          ${(() => { const means = unlockMeansOf(ds, u, answers);
            return means ? `<p class="unlock-means">${esc(means)}</p>` : ""; })()}
          <ul>${routes.map((r) =>
            `<li>${esc(routeName(r))} — ${r.status === "met"
              ? `<b>would be met</b>`
              : `<i>would come within reach${r.gap_max ? ` (${gapAmount(r)})` : r.gap_points ? ` (${r.gap_points} pt${r.gap_points === 1 ? "" : "s"} more)` : ""}</i>`}</li>`).join("")}
          </ul>
        </article>`;
    }

    function renderResults() {
      glossary = new Set();
      // The commit banner belongs to the screen after the commit, and the
      // verdict is not it.
      justRecorded = null;
      // s5: countries the destination answer rules out disappear entirely —
      // their routes fail on a fact the user chose, which is not information.
      const dest = answers["destination"];
      const visible = ds.countries.filter((c) =>
        dest === undefined || dest === "all" || c.code.toLowerCase() === dest);
      const visibleCodes = new Set(visible.map((c) => c.code));
      // A reader who came from a route page is here about that route: it goes
      // first in whatever group it lands in, and everything else keeps the
      // order the engine gave it (scenario step 10).
      const scored = scopedFirst(
        evaluate(ds, answers).filter((r) => visibleCodes.has(r.country)),
        scopedRouteId,
      );
      // A route this reader's own passport is shut out of is not a result. It
      // is not open, it is not within reach, and above all it is not "not yet"
      // — that heading invites them back with a better salary on a permit that
      // will never be theirs. It leaves the three verdicts, the counts and the
      // headline, and stands in its own section with the authority's sentence
      // under it (s8).
      const closedRoutes = scored.filter(isClosed);
      const results = scored.filter((r) => !isClosed(r));

      const applicable = notices(ds, answers);

      /**
       * A route an open question hangs over is not "criteria met".
       *
       * s8 decided not to decide: where the sources conflict about whether a
       * permit is open to a passport at all, the routes stay scored and a
       * notice carries the doubt. The human walked it and found the hole —
       * the notice was above the cards and the card said "criteria met",
       * and only one of those survives being skimmed (2026-09-10). The rules,
       * the quotes and the dates stay exactly as they are; what changes is the
       * heading over them, which stops claiming more than anyone knows.
       */
      const unsettledIds = new Set(
        applicable.filter((n) => n.kind === "open-question").flatMap((n) => n.routes ?? []),
      );
      const unsettled = results.filter((r) => r.status === "met" && unsettledIds.has(r.route.id));
      const settled = results.filter((r) => !unsettled.includes(r));

      const byStatus = {
        met: settled.filter((r) => r.status === "met"),
        near: settled.filter((r) => r.status === "near"),
        hold: settled.filter((r) => r.status === "hold"),
      };
      const met = byStatus.met.length;
      const near = byStatus.near;
      const metCountries = new Set(byStatus.met.map((r) => r.country));

      renderDeclaration(null);
      app.dataset.state = "results";
      setStamp("record");

      const zeroOpen = met + near.length === 0;

      // The screen no route can produce: this passport needs no permit at all.
      // "0 routes look open" is the worst news for the best-placed user and it
      // isn't even true (critique #1) — here the notice IS the result.
      // Only a notice that ANSWERS instead of the routes may take the screen:
      // "you need no permit at all" is the whole story. An extra-rights notice
      // adds to a verdict the rules computed, so it never suppresses one — the
      // zero-open screen keeps its headline and its unlocking steps (s5c).
      const replacing = applicable.filter((n) => n.kind === "no-permit-needed");
      if (replacing.length && zeroOpen) {
        // The headline is the notice's own title: a second copy of it here
        // would drift the moment the dataset states a different notice.
        advance({ kind: "answered-outright", title: replacing[0].title });
        // Any other applicable notice still belongs on the screen — dropping
        // it silenced, say, the Türkiye note (review).
        main.innerHTML = [...replacing, ...applicable.filter((n) => !replacing.includes(n))]
          .map((n) => noticeHtml(n)).join("");
        // The notice screen IS the result for this reader: one entry, like any
        // other screen they can go back from.
        recordScreen(null, true);
        return;
      }

      // s3b: counterfactual leverage — what each alternative step would unlock.
      const ups = unlocks(ds, answers);
      // Notices ride above the normal layout, with the results intact.
      //
      // Two answers that cannot both be true ride at the very top of them: the
      // engine takes the more specific one and evaluates on, which is
      // defensible, but a met verdict resting on an answer the reader
      // contradicted two questions ago must never arrive silently (isolated
      // v1-gate critique, 2026-09-08, F7). The pairs and their wording are the
      // dataset's; the screen only stops being quiet about them.
      const clash = contradictionsIn(ds, answers)
        .map((c) => `<p class="clash" role="status">${esc(c.say)}</p>`).join("");
      const noticeCards = clash + applicable.map((n) => noticeHtml(n)).join("");

      // The subtitle states what was compared, and only a comparison can
      // produce it — the count and the tense come from the same place (B4).
      // What the masthead just said, in plain words, so the screen can announce
      // it: the verdict arrives with no live region at all, and a reader using
      // one is told nothing happened (critique F16). The sentence is written
      // once, in words; the emphasis is markup laid over it, so the announced
      // line is the sentence itself rather than a strip of its own HTML
      // (Standards review, 2026-09-08).
      let verdictText = "";
      const said = (
        sentence: string, emphasis = "", rest: { nearest?: string; explore?: Explore } = {},
      ) => {
        verdictText = emphasis ? `${sentence} ${emphasis}` : sentence;
        advance({
          kind: "compare", routes: results.length,
          headline: emphasis ? `${sentence} <b>${emphasis}</b>` : sentence,
          ...rest,
        });
      };
      /** The verdict, announced after the screen it belongs to is drawn. */
      const sayVerdict = () => { announce(verdictText); };

      if (zeroOpen && unsettled.length) {
        // Not "nothing open": their rules are met and the doubt is about the
        // passport, which is the notice's business and not the rules'. Saying
        // nothing is open here would contradict the section right below it
        // (human's walk, 2026-09-10).
        const n = unsettled.length;
        said(
          `${n} route${n === 1 ? "" : "s"} meet${n === 1 ? "s" : ""} the rules — whether your passport `
          + `can use ${n === 1 ? "it" : "them"} is unsettled.`,
          "",
        );
      } else if (zeroOpen && ups.length) {
        // The step worth naming: one that would fully meet a route beats one
        // that only brings routes within reach, then breadth, then dataset
        // order (strict >, so ties keep the engine's order).
        const rank = (u: (typeof ups)[number]) =>
          (u.routes.some((r) => r.status === "met") ? 1e6 : 0) + u.routes.length;
        const bestUp = ups.reduce((best, u) => (rank(u) > rank(best) ? u : best));
        // Zero open is a starting point, not a dead end — the steps are the news.
        said(`Nothing open yet — ${ups.length} step${ups.length === 1 ? "" : "s"} would change that.`,
          "", { nearest: unlockTitleOf(ds, bestUp, answers) });
      } else if (zeroOpen) {
        // Nothing open and no single step would open one: no false hope. The
        // single-country result has no country sections to send anyone to, so
        // it does not pretend otherwise (F7).
        // What to do next is part of the one line, not a second sentence
        // appended to the element afterwards (review J2).
        said("Nothing open on these answers.", "", {
          explore: visible.length === 1 ? "one-country" : "several-countries",
        });
      } else {
        const nearNote = near.length
          ? near[0].gap_max
            ? `One is short by ${gapAmount(near[0])}.`
            : near[0].gap_points
              ? `One is ${near[0].gap_points} point${near[0].gap_points === 1 ? "" : "s"} away.`
              : ""
          : "";
        const across = metCountries.size > 1 ? ` across ${metCountries.size} countries` : "";
        said(`${met} route${met === 1 ? "" : "s"} look${met === 1 ? "s" : ""} open${across}.`, nearNote);
      }

      // Counted the way the rows read: an unknown on a hard-failed route is
      // moot, and no learn box offers to resolve it (critique #4).
      const openUnknownCount = (rs: RouteResult[]) => rs.filter(hasLiveUnknown).length;
      const openUnknowns = openUnknownCount(results);

      const strip = `<div class="strip" aria-label="Summary">
          <span class="s-met">${byStatus.met.length} open</span>
          <span class="s-near">${byStatus.near.length} within reach</span>
          ${unsettled.length ? `<span class="s-unsettled">${unsettled.length} unsettled for your passport</span>` : ""}
          ${closedRoutes.length ? `<span class="s-closed">${closedRoutes.length} not open to your passport</span>` : ""}
          <span class="s-hold">${byStatus.hold.length} not yet${openUnknowns ? ` — ${openUnknowns} ${openUnknowns === 1 ? "has" : "have"} an open unknown` : ""}</span>
        </div>`;

      // A heading, not a styled div: the results page had no heading above H3,
      // so "OPEN — CRITERIA MET (5)" was not a heading at all and no reader
      // using headings to move could find a section (critique F16).
      const section = (title: string, cls: string, inner: string, count: number) =>
        count ? `<h2 class="ghead ${cls}"><b>${title}</b> (${count})</h2><div class="stack">${inner}</div>` : "";

      /**
       * The routes this reader's passport is shut out of, said once and said
       * plainly. It goes last, under a heading that closes rather than defers:
       * these are not steps away, and the section that means "come back with
       * more" is the one place they must never be filed.
       */
      const closedSection = (rows: RouteResult[]) => section(
        "Not open to your passport", "closed",
        rows.map(closedRowHtml).join(""), rows.length,
      );

      /** The rules are met; whether the route is theirs at all is the question
       * in the notice above, and the heading says so rather than the card.
       *
       * The line names no country and no passport. It said "Whether France
       * opens this permit to an Algerian passport" — true of the only notice
       * that exists today, and wrong the first time a second one marks a route
       * anywhere else (2026-09-10). */
      const unsettledSection = (rows: RouteResult[], withCountry = true) => rows.length
        ? section(
          "Open on the rules — unsettled for your passport", "unsettled",
          `<p class="why">` + esc("The rules below are met by what you declared. Whether this permit "
            + "is open to your passport at all is the question in the note above.")
          + `</p>` + rows.map((r) => fullCard(r, withCountry, true)).join(""),
          rows.length,
        )
        : "";

      const seekHint = (rs: RouteResult[], hasUnlocks: boolean) =>
        hasUnlocks && rs.some((r) => r.route.kind === "seek" && r.status !== "hold")
          ? `<p class="unlock-hint">Your job-search permit above is exactly for this — lawful time in the country to land that offer.</p>`
          : "";

      if (visible.length === 1) {
        // Single destination: the flat s3 layout, no country chrome.
        // Built where it is read, not before it: a screen explains an
        // abbreviation on its FIRST use, so what a section renders first must
        // also be what it renders first (human, 2026-09-08).
        const unlockSection = () => ups.length
          ? `<h2 class="ghead unlockh"><b>Steps that would unlock more</b> — each re-checked against the rules</h2>` +
            ups.map((u) => unlockCard(u, u.routes)).join("") +
            seekHint(results, true)
          : "";
        main.innerHTML = arrivalLine() + noticeCards + strip +
          section("Open — criteria met", "", byStatus.met.map((r) => fullCard(r)).join(""), byStatus.met.length) +
          unsettledSection(unsettled) +
          section("Within reach", "near", byStatus.near.map((r) => fullCard(r)).join(""), byStatus.near.length) +
          unlockSection() +
          section("Not yet", "hold", holdList(byStatus.hold, ups.length > 0), byStatus.hold.length) +
          closedSection(closedRoutes);
        showArrival();
        sayVerdict();
        return;
      }

      // Multi destination: collapsible country sections; hopeful countries open,
      // all-hold ones collapsed with the tally (and any unlocking steps) visible.
      // With nothing open anywhere, the first country that has steps opens
      // instead — the hope is the point, and it was hidden in 10px tally text.
      const withUps = new Set(ups.flatMap((u) => u.routes.map((r) => r.country)));
      main.innerHTML = arrivalLine() + noticeCards + strip + visible.map((c) => {
        const rs = results.filter((r) => r.country === c.code);
        const cUnsettled = rs.filter((r) => r.status === "met" && unsettledIds.has(r.route.id));
        const g = {
          met: rs.filter((r) => r.status === "met" && !unsettledIds.has(r.route.id)),
          near: rs.filter((r) => r.status === "near"),
          hold: rs.filter((r) => r.status === "hold"),
        };
        // Country-scoped unlock rows: each row's routes narrowed to this country.
        const cUps = ups
          .map((u) => ({ u, routes: u.routes.filter((r) => r.country === c.code) }))
          .filter((x) => x.routes.length);
        const unknowns = openUnknownCount(rs);
        // A country's own closed routes are counted in its tally: the section
        // that holds them is collapsed when nothing is open, and a count no
        // summary names is a route the reader never learns exists (s8).
        const cClosed = closedRoutes.filter((r) => r.country === c.code);
        const tallyParts = [
          g.met.length ? `${g.met.length} open` : "",
          cUnsettled.length ? `${cUnsettled.length} unsettled for your passport` : "",
          g.near.length ? `${g.near.length} within reach` : "",
          g.hold.length ? `${g.hold.length} not yet${unknowns ? ` — ${unknowns} ${unknowns === 1 ? "has" : "have"} an open unknown` : ""}` : "",
          cClosed.length ? `${cClosed.length} not open to your passport` : "",
          cUps.length ? `<i>${cUps.length} unlocking step${cUps.length === 1 ? "" : "s"}</i>` : "",
        ].filter(Boolean).join(" · ");
        // With nothing open, the steps ARE the news: every section holding one
        // opens. Announcing "6 steps" and hiding two inside collapsed sections
        // is the withholding the headline exists to end (critique #4).
        const open = g.met.length + cUnsettled.length + g.near.length > 0 || (zeroOpen && withUps.has(c.code));
        const inner =
          section("Open — criteria met", "", g.met.map((r) => fullCard(r, false)).join(""), g.met.length) +
          unsettledSection(cUnsettled, false) +
          section("Within reach", "near", g.near.map((r) => fullCard(r, false)).join(""), g.near.length) +
          (cUps.length
            ? `<h2 class="ghead unlockh"><b>Steps that would unlock more here</b></h2>` +
              cUps.map((x) => unlockCard(x.u, x.routes)).join("") +
              seekHint(rs, true)
            : "") +
          section("Not yet", "hold", holdList(g.hold, cUps.length > 0), g.hold.length) +
          closedSection(cClosed);
        return `<details class="country-sec"${open ? " open" : ""}>
            <summary>${esc(c.name)} <span class="tally">${tallyParts}</span></summary>
            <div class="cbody">${inner}</div>
          </details>`;
      }).join("");
      showArrival();
      sayVerdict();
      recordScreen(null, true);
    }

    /**
     * The record, kept on this device so a reload, a closed tab or the phone's
     * Back button no longer destroys a thirteen-question interview
     * (product-critique v0.7, F2/F10). Nothing is transmitted; `localStorage`
     * is per-browser, so the answers do not reach the person's other devices
     * either. Storage can be unavailable (private mode, blocked site data) —
     * the interview must still work, just without surviving the tab.
     */
    /** The browser's own store, if it has one: reading the property itself
     * throws where site data is blocked. What is done with it — what is kept,
     * what is dropped, what "Start over" takes with it — belongs to
     * `record.ts`, where it is tested against a store in a bottle. */
    const store: RecordStore | null = (() => {
      try {
        return window.localStorage;
      } catch { return null; }
    })();
    const saveRecord = () => writeRecord(store, answers, asked);
    function loadRecord() {
      const kept = readRecord(store, ds.fields.map((f) => f.id));
      answers = kept.answers;
      asked = kept.history;
      // The rules may have moved since it was written: replay drops anything
      // this interview would no longer ask.
      replayAnswers();
    }

    restart.addEventListener("click", (e) => {
      e.preventDefault();
      // A shared or borrowed computer must not hand the next person a
      // stranger's salary: the stored record goes with the screen.
      answers = {}; asked = []; editing = null;
      clearRecord(store);
      // Back must not undo it: the entries go with the record, so anything
      // behind us now restores nothing and the browser simply leaves the page.
      screens.entries.length = 0;
      screens.current = -1;
      app.dataset.state = "questions";
      setStamp("rules-read");
      renderQuestion({ kind: "reset" });
    });

    /**
     * Browser Back is the phone's "previous question" gesture, and it has to
     * mean exactly what the screen's own "← Back" means.
     *
     * It did not. Every render pushed an entry — answering, editing, going
     * back, a notice — so the entries stopped corresponding to the questions:
     * on the human's phone walk of 2026-09-08 three answers grew `history` by
     * one entry while the page's own counter reached 7, the first back gesture
     * jumped three questions, and the second went FORWARD. (A phone throttles
     * a burst of `pushState` calls and drops the extra entries; the page kept
     * counting, so its state numbers named snapshots the browser no longer
     * had.)
     *
     * One entry per question screen, then, and one gesture behind both Backs:
     * advancing to a new question pushes, every other render replaces the entry
     * it is standing on, and "← Back" IS `history.back()`. An entry remembers
     * which question it was showing rather than a copy of the answers, so
     * stepping back keeps everything answered since — the same thing editing an
     * earlier row has always done.
     */
    const screens = emptyHistory();
    /** Whether we are the ones moving the reader, rather than the browser. */
    let restoring = false;

    function recordScreen(field: string | null, advance: boolean) {
      if (restoring) return;
      const move = recordEntry(screens, field, advance);
      const state = { step: move.step };
      // The first screen REPLACES the page's own entry rather than adding one:
      // pushing there would trap the visitor on the site, because Back would
      // always land on another of our own screens.
      if (move.how === "push") window.history.pushState(state, "");
      else window.history.replaceState(state, "");
    }

    window.addEventListener("popstate", (e) => {
      const step = (e.state as { step?: number } | null)?.step;
      // An entry we did not write, or one "Start over" has since invalidated:
      // leave the screen alone rather than restoring a stranger's answers.
      if (typeof step !== "number") return;
      // A step this page has no entry for — a reload rebuilt a shorter list,
      // or the dataset stopped asking something — lands on the nearest question
      // it does have. Doing nothing is what left the gesture dead.
      const at = clampStep(screens, step);
      const screen = screenAt(screens, at);
      if (!screen) return;
      screens.current = at;
      restoring = true;
      if (screen.field === null) {
        editing = null;
        renderResults();
      } else {
        // The question that entry was showing, with everything answered since
        // still on the record — back is a step, not an undo.
        editing = screen.field;
        setStamp("rules-read");
        app.dataset.state = "questions";
        renderQuestion({ kind: "restore" });
      }
      restoring = false;
    });

    /**
     * The ledger is a fixed panel on a wide screen and a one-line disclosure
     * on a phone, where it sat between the intro and the question and pushed
     * the question below the fold (product-critique v0.7, F8). Wide always
     * open — its summary is not a control there. Narrow starts collapsed, and
     * once the person opens or closes it themselves, that decision stands.
     */
    const wide = window.matchMedia("(min-width: 761px)");
    let ledgerChosen = false;
    const syncLedger = () => { if (!ledgerChosen || wide.matches) decl.open = wide.matches; };
    decl.addEventListener("toggle", () => { if (!wide.matches) ledgerChosen = true; });
    wide.addEventListener("change", syncLedger);
    syncLedger();

    /**
     * A printed record that hides its own evidence is not a record: every
     * collapsed section opens for the print and closes again afterwards. CSS
     * alone cannot do it — a closed <details> hides its contents below the
     * level a stylesheet reaches.
     */
    const printOpened: HTMLDetailsElement[] = [];
    window.addEventListener("beforeprint", () => {
      for (const d of document.querySelectorAll<HTMLDetailsElement>("details"))
        if (!d.open) { d.open = true; printOpened.push(d); }
    });
    window.addEventListener("afterprint", () => {
      for (const d of printOpened.splice(0)) d.open = false;
    });

    loadRecord();
    // A route page's call to action lands here already scoped to its country.
    scopeFromLink();

    // Dev-only screenshot hook (stripped from production builds): pre-fill a
    // profile via ?dev-profile={"destination":"de",...} to land on any screen.
    if (import.meta.env.DEV) {
      const raw = new URLSearchParams(location.search).get("dev-profile");
      if (raw) {
        try {
          answers = JSON.parse(raw);
          asked = Object.keys(answers);
        } catch { /* fall through to the normal flow */ }
      }
    }

    // The first screen is whatever the stored record left behind — a fresh
    // interview when there is none.
    renderQuestion({ kind: "restore" });

    /**
     * After a reload the browser still holds every entry this page pushed
     * before it, and the page holds none of them: `step` restarted at 0 while
     * `history.length` stayed where it was, so browser Back found no screen and
     * the page's own Back fell through to the edit path (Spec review,
     * 2026-09-08). The record knows what was answered and in what order — that
     * is the list, rebuilt, with the entry we are standing on rewritten to
     * match it.
     */
    (() => {
      const showing = screenAt(screens, screens.current)?.field ?? null;
      const rebuilt = historyFor(asked, showing);
      screens.entries = rebuilt.entries;
      screens.current = rebuilt.current;
      window.history.replaceState({ step: screens.current }, "");
    })();

    // Dev-only layout probe: ?dev-probe=1 writes the widest offenders into the
    // title so headless --dump-dom can report horizontal overflow (golden G1).
    if (import.meta.env.DEV && new URLSearchParams(location.search).has("dev-probe")) {
      const w = document.documentElement.clientWidth;
      const bad = [...document.querySelectorAll<HTMLElement>("body *")]
        .map((el) => ({ el, r: el.getBoundingClientRect() }))
        .filter((x) => x.r.right > w + 1)
        .slice(0, 8)
        .map((x) => `${x.el.tagName.toLowerCase()}.${x.el.className || "-"}:${Math.round(x.r.right)}`);
      document.title = `probe w=${w} sw=${document.documentElement.scrollWidth} | ${bad.join(" ; ")}`;
    }
  </script>

  <style is:global>
    *{margin:0;padding:0;box-sizing:border-box}
    body{background:var(--color-bg);color:var(--color-ink);font:var(--text-body);padding:2.8rem 1.2rem 4rem}
    .wrap{max-width:var(--max-content);margin:0 auto}
    a{color:var(--color-stamp)}

    /* The masthead below the site header. The header itself — its rule, its
       wordmark and its seal — belongs to identity.css: three rules here were
       painting the shared header a second way, which is how one product grows
       two identities (Standards review, 2026-09-08). */
    .masthead-with-stamps{border-bottom:var(--rule-heavy);padding-bottom:1.3rem;margin-bottom:var(--space-5)}
    .brand{font:var(--text-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--color-muted);margin-top:.35rem}
    /* What the interview asks of a route, said on the card in the same words
       the route page uses — ink on card, no new colour and no verdict colour. */
    .scoped{font:var(--text-source);color:var(--color-muted);margin:.35rem 0 .1rem}
    .scoped a{font-weight:600;text-decoration:none;display:inline-flex;align-items:center;min-height:var(--tap-min)}
    .foot-links{display:flex;flex-wrap:wrap;gap:.3rem 1.2rem;margin-top:.6rem;font-size:.8rem}
    .foot-links a{display:inline-flex;align-items:center;min-height:var(--tap-min)}
    h1{font:var(--text-hero);margin:.5rem 0 .4rem;max-width:var(--max-prose)}
    h1 b{color:var(--color-near)}
    .sub{color:var(--color-muted);max-width:38rem;font-size:.92rem}

    /* The question is first in the DOM so a phone opens on it; on a wide
       screen `order` puts the ledger back in the left column (F8). */
    .cols{display:grid;grid-template-columns:15.5rem 1fr;gap:1.5rem;align-items:start}
    .decl{order:1;background:var(--color-card);border:var(--rule-soft);padding:1.1rem 1.2rem;position:sticky;top:1rem}
    main{order:2;min-width:0}
    .decl > summary{list-style:none;cursor:pointer;font:var(--text-label);letter-spacing:var(--tracking-label);
      text-transform:uppercase;color:var(--color-muted);border-bottom:2px solid var(--color-ink);
      padding-bottom:.4rem;margin-bottom:.6rem;display:flex;justify-content:space-between;gap:.6rem;
      align-items:baseline;min-height:var(--tap-min)}
    .decl > summary::-webkit-details-marker{display:none}
    .decl-title{white-space:nowrap}
    .decl-count{font:500 .7rem var(--font-mono);text-transform:none;letter-spacing:0;text-align:right}
    .decl dl div{display:flex;justify-content:space-between;gap:.6rem;border-bottom:var(--rule-dotted);padding:.42rem 0}
    .decl dt{color:var(--color-muted);font-size:.78rem}
    .decl dd{font:var(--text-value);text-align:right}
    .decl div.done{cursor:pointer;min-height:var(--tap-min);align-items:center}
    .decl div.done:hover dd,.decl div.done:focus-visible dd{color:var(--color-stamp)}
    .decl .pen{color:var(--color-muted);font-size:.75rem;margin-left:.2rem}
    .decl div.done:hover .pen{color:var(--color-stamp)}
    .decl dd.pending{color:var(--color-muted);font-weight:400}
    .decl .edit{display:inline-flex;align-items:center;margin-top:.8rem;font-size:.85rem;min-height:var(--tap-min)}
    .decl .edit[hidden]{display:none}

    /* Question mode */
    .qcard{background:var(--color-card);border:var(--rule-soft);border-top:var(--rule-card-top);padding:1.6rem 1.8rem}
    .qmeta{font:var(--text-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--color-muted)}
    .qlabel{font:var(--text-route);font-size:1.25rem;margin:.5rem 0 1rem}
    .opts{display:grid;gap:.5rem}
    .opt{font:600 .92rem var(--font-sans);text-align:left;background:var(--color-bg);border:var(--rule-soft);
      padding:.7rem .9rem;min-height:var(--tap-min);cursor:pointer;color:var(--color-ink);display:block}
    /* What the answer means, under the answer. Muted and lighter than the
       label: it settles a choice, it does not compete with it. */
    .opt-means{display:block;margin-top:.3rem;font:400 .8rem var(--font-sans);color:var(--color-muted);
      white-space:normal;line-height:1.45}
    .opt.sel .opt-means{color:var(--color-ink)}
    .opt:hover{border-color:var(--color-ink);background:var(--color-band-soft)}
    .back{margin-top:1rem;background:none;border:none;color:var(--color-muted);cursor:pointer;font:inherit;font-size:.9rem;
      min-height:var(--tap-min);padding:.2rem .1rem}
    .back + .back{margin-left:1.4rem;color:var(--color-band);font-weight:600}

    /* s5c: the question whose answer set is a list, not a handful of buttons.
       Type to filter; the list below is the same option set the engine derives.
       NB: .hint is scoped to .qcard — a bare .hint would reach any future
       hint text on the results side (the .country/.country-sec lesson). */
    .csearch{position:relative;max-width:26rem}
    .csearch input{width:100%;font:600 .95rem var(--font-sans);color:var(--color-ink);background:var(--color-bg);
      border:var(--rule-soft);border-bottom:2px solid var(--color-ink);padding:.65rem .8rem .65rem 2rem}
    .csearch input::placeholder{color:var(--color-muted);font-weight:400}
    .csearch .mag{position:absolute;left:.7rem;top:.72rem;color:var(--color-muted);font-size:.9rem}
    .clist{margin-top:.5rem;max-height:15rem;overflow-y:auto;border:var(--rule-soft);background:var(--color-bg)}
    .copt{display:flex;justify-content:space-between;align-items:center;gap:.8rem;width:100%;text-align:left;
      background:none;border:none;border-bottom:var(--rule-dotted);padding:.6rem .8rem;cursor:pointer;
      min-height:var(--tap-min);font:600 .9rem var(--font-sans);color:var(--color-ink)}
    .copt:hover{background:var(--color-band-soft)}
    .copt .cls{font:500 .68rem var(--font-mono);color:var(--color-muted);text-transform:none;letter-spacing:0;
      text-align:right;flex-shrink:0}
    .copt.on{background:var(--color-band-soft);box-shadow:inset 3px 0 0 var(--color-band)}
    .opt.sel,.copt.sel{border-color:var(--color-band);box-shadow:inset 3px 0 0 var(--color-band)}
    .opt.sel{background:var(--color-band-soft)}
    .tick{color:var(--color-band);font-weight:700;margin-left:.35rem}
    .copt.on .cls{color:var(--color-band)}
    .visually-hidden{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
    .cnone,.cmore{font:500 .8rem var(--font-mono);color:var(--color-muted);padding:.7rem .8rem}
    .qcard .hint{font-size:.8rem;color:var(--color-muted);margin-top:.6rem;max-width:32rem}
    /* The way to look an answer up, at the question that asks for it. */
    .qlearn{font-size:.85rem;color:var(--color-muted);margin:.15rem 0 .6rem}
    .qlearn a{color:var(--color-band);font-weight:600;text-decoration:none}
    .qlearn a::after{content:" ↗"}
    /* Two answers that cannot both be true, said before the verdicts. */
    .clash{font-size:.9rem;color:var(--color-ink);background:var(--color-near-soft);border-left:3px solid var(--color-near);padding:.6rem .8rem;margin:0 0 .8rem}
    /* B1: after Enter, the card itself says which country went on the record —
       a monospace line in the side panel is not where a person is looking. */
    .recorded{margin-top:.6rem;font-size:.88rem;color:var(--color-ink)}
    .recorded b{color:var(--color-band)}
    .recorded[hidden]{display:none}

    /* Result summary + groups (s3) */
    .strip{display:flex;gap:.6rem;margin:0 0 .4rem;flex-wrap:wrap}
    .strip span{font:600 .78rem var(--font-sans);letter-spacing:.08em;text-transform:uppercase;padding:.45rem .8rem;border:var(--rule-soft);background:var(--color-card)}
    .strip .s-met{border-left:3px solid var(--color-met);color:var(--color-met)}
    .strip .s-near{border-left:3px solid var(--color-near);color:var(--color-near)}
    .strip .s-hold{border-left:3px solid var(--color-hold);color:var(--color-hold)}
    .strip .s-unsettled{border-left:3px solid var(--color-ink);color:var(--color-ink)}
    .strip .s-closed{border-left:3px solid var(--color-hold);color:var(--color-hold)}
    /* A heading element, sized as the section label it always looked like. */
    h2.ghead{font:700 .74rem var(--font-sans);letter-spacing:.3em;text-transform:uppercase;color:var(--color-muted);
      border-bottom:var(--rule-soft);padding-bottom:.35rem;margin:1.4rem 0 .8rem}
    /* The card the reader came from, marked where they left off. */
    .route[data-came-from],details.route-hold[data-came-from]{border-left:3px solid var(--color-band)}
    .from-here{font:600 .74rem var(--font-sans);letter-spacing:.14em;text-transform:uppercase;
      color:var(--color-band);margin-bottom:.35rem}

    /* s5: collapsible country sections (multi-destination results).
       NB: named .country-sec — .country is the small chip on cards, and the
       chip's uppercase/letter-spacing would inherit into the whole section. */
    details.country-sec > summary{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;cursor:pointer;list-style:none;
      font:700 .8rem var(--font-sans);letter-spacing:.3em;text-transform:uppercase;color:var(--color-ink);
      border-bottom:2px solid var(--color-ink);padding-bottom:.4rem;margin:1.8rem 0 .4rem}
    details.country-sec > summary::-webkit-details-marker{display:none}
    details.country-sec > summary::before{content:"▸ ";color:var(--color-muted)}
    details.country-sec[open] > summary::before{content:"▾ "}
    .tally{font:600 .68rem var(--font-mono);letter-spacing:.06em;color:var(--color-muted);text-transform:none;text-align:right}
    .tally i{font-style:normal;color:var(--color-band)}
    .cbody{padding-bottom:.4rem}
    .cbody .ghead{margin:1rem 0 .6rem}
    .ghead b{color:var(--color-met)} .ghead.near b{color:var(--color-near)} .ghead.hold b{color:var(--color-hold)}
    .ghead.unsettled b{color:var(--color-ink)}
    .ghead.closed b{color:var(--color-hold)}
    details.route-hold{background:var(--color-card);border:var(--rule-soft);padding:.55rem .9rem}
    details.route-hold summary{cursor:pointer;display:flex;gap:.8rem;align-items:baseline;list-style:none;font-size:.88rem;
      min-height:var(--tap-min);padding:.35rem 0}
    details.route-hold summary::-webkit-details-marker{display:none}
    .hold-name{font:600 .92rem var(--font-serif)}
    .hold-why{color:var(--color-muted);font-size:.8rem;margin-left:auto;text-align:right}
    .hold-body{padding:.6rem 0 .3rem;border-top:var(--rule-dotted);margin-top:.5rem}
    .faildetail{list-style:none;display:grid;gap:.3rem;margin:.5rem 0 .2rem;font-size:.84rem;color:#54513f}
    .faildetail li::before{content:"✗ ";color:var(--color-stamp)}
    .faildetail li.unknown::before{content:"? ";color:var(--color-hold);font-weight:700}
    .faildetail b{color:var(--color-ink)}
    .ghead.unlockh b{color:var(--color-band)}
    .unlock{background:var(--color-card);border:var(--rule-soft);border-left:3px solid var(--color-band);padding:.85rem 1.05rem;margin-bottom:.7rem}
    .unlock h3{font:600 .95rem var(--font-serif);margin-bottom:.35rem}
    .unlock-means{font-size:.82rem;color:var(--color-muted);margin:-.15rem 0 .4rem;max-width:34rem}
    .unlock h3 b{color:var(--color-band)}
    .unlock ul{list-style:none;display:grid;gap:.3rem;font-size:.86rem;color:#54513f}
    .unlock li::before{content:"→ ";color:var(--color-met);font-weight:700}
    .unlock li b{color:var(--color-met)}
    .unlock li i{color:var(--color-near);font-style:normal;font-weight:600}
    .unlock-hint{font-size:.8rem;color:var(--color-muted);margin:-.2rem 0 .4rem;max-width:38rem}
    /* s5b: conditions the authority applies that the interview never asked —
       the card must not read as a green light on them (critique #2). */
    .precond{font-size:.83rem;color:#54513f;border-left:3px solid var(--color-hold);padding:.45rem .75rem;margin-top:.55rem;max-width:34rem}
    .precond b{color:var(--color-hold)}
    /* A caveat is not a hurdle — it reads as an aside, not as one more bar. */
    .caveat{font-size:.83rem;color:var(--color-muted);border-left:3px solid var(--color-muted);
      padding:.45rem .75rem;margin-top:.55rem;max-width:34rem}
    .caveat b{color:var(--color-ink)}
    /* A caveat we could not find the wording for says so in its own voice,
       and says why (human catch 2026-09-07). */
    .caveat.nosrc i{font-style:italic;opacity:.85}
    .caveat.ours{border-left-style:dashed}
    /* s7: a condition the authority itself does not apply to this passport.
       It is news in the reader's favour, so it wears the met colour rather
       than the muted rule a caveat wears. */
    .caveat.carveout{border-left-color:var(--color-met);color:var(--color-ink)}
    .caveat.carveout b{color:var(--color-met)}
    /* s5b: the situation-gated rows, said once (critique #5b). */
    details.hold-group{margin-top:.1rem}
    details.hold-group > summary{cursor:pointer;list-style:none;font:600 .82rem var(--font-sans);color:var(--color-muted);
      background:var(--color-card);border:var(--rule-soft);border-left:3px solid var(--color-hold);padding:.55rem .9rem}
    details.hold-group > summary::-webkit-details-marker{display:none}
    details.hold-group > summary::before{content:"▸ ";color:var(--color-muted)}
    details.hold-group[open] > summary::before{content:"▾ "}
    .hold-group-body{display:grid;gap:var(--gap-cards);padding:.5rem 0 .2rem .9rem}
    /* s5b: the passport that needs no permit (critique #1). */
    .notice{background:var(--color-card);border:var(--rule-soft);border-top:var(--rule-card-top);border-left:3px solid var(--color-met);
      padding:var(--pad-card);margin-bottom:var(--gap-cards)}
    .notice h3{font:var(--text-route);color:var(--color-met);margin-bottom:.35rem}
    /* s5c: an extra-rights notice sits BESIDE a computed verdict — the met
       green would read as a route the rules opened, which it is not. */
    .notice.extra-rights,.notice.open-question{border-left-color:var(--color-band)}
    .notice.extra-rights h3,.notice.open-question h3{color:var(--color-ink)}
    /* s8: a route the authority closes to this reader's passport. It wears the
       hold grey and not the met green, and it is deliberately not the hold
       card: nothing about it is "not yet". */
    .closed{background:var(--color-card);border:var(--rule-soft);border-left:3px solid var(--color-hold);padding:var(--pad-card)}
    .closed h3{font:var(--text-route);margin-bottom:.35rem}
    .closed .why{margin-bottom:.5rem}
    .faildetail li.moot::before,.faildetail li.where::before{content:"— ";color:var(--color-muted)}
    .faildetail li.moot{color:var(--color-met)}
    .learn{font-size:.83rem;background:var(--color-band-soft);border-left:3px solid var(--color-band);padding:.5rem .75rem;margin-top:.55rem;max-width:34rem}
    .learn a{color:var(--color-band);font-weight:600;text-decoration:none;
      display:inline-flex;align-items:center;min-height:var(--tap-min)}
    .learn a::after{content:" ↗"}

    /* Result cards */
    .stack{display:grid;gap:var(--gap-cards)}
    .route{background:var(--color-card);border:var(--rule-soft);border-top:var(--rule-card-top);padding:var(--pad-card)}
    .top{display:flex;justify-content:space-between;gap:1rem;align-items:baseline}
    .country{font:700 .68rem var(--font-sans);letter-spacing:.22em;text-transform:uppercase;color:var(--color-muted)}
    h3{font:var(--text-route);margin:.15rem 0 .25rem}
    .st{font:700 .66rem var(--font-sans);letter-spacing:.14em;text-transform:uppercase;padding:.3rem .65rem;white-space:nowrap}
    .st.met{background:var(--color-met-soft);color:var(--color-met)}
    .st.near{background:var(--color-near-soft);color:var(--color-near)}
    .st.hold{background:var(--color-hold-soft);color:var(--color-hold)}
    .st.unsettled{background:var(--color-hold-soft);color:var(--color-ink)}
    .why{color:#54513f;font-size:.88rem;max-width:var(--max-prose)}

    .rail{margin:.95rem 0 .2rem;max-width:34rem}
    .bar{position:relative;height:var(--rail-h);background:var(--rail-track);border-radius:99px}
    .you{position:absolute;top:0;bottom:0;background:var(--rail-band);border-radius:99px}
    /* NB: named .rail-tick — .tick is the chosen-answer checkmark above, and its
       margin-left was pushing every line on this bar off the amount it marks. */
    .rail-tick{position:absolute;top:-5px;width:2px;height:17px;background:var(--rail-tick)}
    /* One line per mark on the bar, in reading order, each with the swatch of
       the thing it names. The labels used to be positioned over the bar and
       wrapped into a three-line stack at the right edge; a list cannot collide
       at any width, which is the same conclusion the route page's rail reached
       (critique B1, human walk 2026-09-08). */
    .rail-rows{list-style:none;margin:.55rem 0 0;padding:0;display:grid;gap:.15rem;
      font:500 .72rem var(--font-mono)}
    .rail-rows li{display:flex;align-items:baseline;gap:.5rem;padding:.12rem 0;
      border-bottom:var(--rule-dotted)}
    .rail-rows li:last-child{border-bottom:none}
    .rail-rows b{color:var(--color-ink);font-weight:600;white-space:nowrap}
    .rail-rows li > span:last-child{color:var(--color-muted);text-align:right;margin-left:auto;
      white-space:normal;line-height:1.35}
    .sw{flex:none;width:.62rem;height:.62rem;border-radius:2px;align-self:center}
    .sw-asks{background:var(--rail-tick)}
    .sw-you{background:var(--rail-band)}
    .rail-rows li:last-child b{color:var(--color-band)}
    .gapnote{font-size:.85rem;background:var(--color-near-soft);border-left:3px solid var(--color-near);color:#63430f;
      padding:.5rem .75rem;margin-top:.55rem;max-width:34rem}
    .ptsline{font:500 .8rem var(--font-mono);color:var(--color-ink);margin:.5rem 0 .1rem}
    .ptsline b{color:var(--color-met)}

    .foot{display:flex;justify-content:space-between;gap:1rem;align-items:baseline;border-top:var(--rule-dotted);
      margin-top:.85rem;padding-top:.6rem;flex-wrap:wrap}
    .srcs{display:grid;gap:.3rem;flex:1;min-width:16rem}
    .src{font:var(--text-source);color:var(--color-muted)}
    .src b{color:var(--color-met);font-weight:500}
    .src.nosrc{font-style:italic}
    /* Where a route states two thresholds, both quotes stay — the reader may
       want to know the other exists — but only one of them is theirs. */
    .src .applies{color:var(--color-met)}
    .src.unapplied{opacity:.72}
    .src .applies-not{font-style:italic}
    /* The link that proves the quote was the hardest thing on the page to tap:
       84×16 px against a floor of 44 (isolated v1-gate critique, 2026-09-08,
       F6). Its box is the floor now, and the tail keeps its own line height. */
    .next{font:600 .78rem var(--font-sans);text-decoration:none;white-space:nowrap;
      display:inline-flex;align-items:center;min-height:var(--tap-min)}
    .next::after{content:" ↗"}

    footer{margin-top:var(--space-6);color:var(--color-muted);font-size:.8rem;border-top:var(--rule-heavy);padding-top:.9rem}
    footer p{margin:0}
    .health{margin-top:.6rem;padding-top:.55rem;border-top:var(--rule-dotted);font:var(--text-source);
      display:flex;justify-content:space-between;flex-wrap:wrap;gap:.3rem 1.5rem}

    @media (max-width:760px){
      body{padding:1.4rem .9rem 3rem}
      .cols{grid-template-columns:1fr}
      /* The question card comes first; "You declared" follows it, collapsed to
         one line that expands on tap (F8). */
      main{order:1}
      .decl{order:2;position:static}
      .decl > summary{margin-bottom:0}
      .decl[open] > summary{margin-bottom:.6rem}
      .qcard{padding:1.1rem 1rem}
      .opt{white-space:normal}
      .copt{flex-wrap:wrap;gap:.15rem}
      .copt .cls{text-align:left}
      .top{flex-wrap:wrap}
      details.country-sec > summary{flex-wrap:wrap;letter-spacing:.18em}
      .tally{text-align:left}
      h1{font-size:1.6rem}
      .stamps[hidden]{display:none}
    }
    /* Wide: the ledger is a fixed panel, so its disclosure control is not a
       control at all — the script keeps it open. */
    /* Wide: the ledger is a fixed panel, so its disclosure control is not a
       control at all — it stays the panel heading, and the script keeps the
       panel open. */
    @media (min-width:761px){
      .decl > summary{cursor:default;pointer-events:none;min-height:0}
      .decl-count{display:none}
    }

    /* The record, on paper. A person can take the printout to an appointment:
       the quotes and the read dates are the point, and the navigation is not
       (product-critique v0.7, F10). */
    @media print{
      body{background:#fff;color:#000;padding:0;font-size:11pt}
      .decl > summary,.back,.edit,.next,#restart,.strip,.cnone,.cmore,.csearch,.clist{display:none!important}
      .wrap{max-width:none}
      header .stamps{position:static;margin:.6rem 0 0 auto;height:auto}
      .stamps .mark{display:none}
      .stamps .stamp{position:static;transform:none;border:1px solid #000;color:#000;background:none;white-space:normal}
      .cols{display:block}
      .decl{border:1px solid #000;margin-bottom:1rem;position:static;page-break-inside:avoid}
      details{display:block}
      details > summary{list-style:none}
      /* Everything folded away on screen prints open: a printed record that
         hides its own evidence is not a record. */
      details > *{display:revert!important}
      .route,.unlock,.notice,details.route-hold{page-break-inside:avoid;border:1px solid #999}
      .src{color:#000;font-size:9pt}
      a[href]::after{content:" (" attr(href) ")";font-size:8pt;word-break:break-all}
      .learn a::after,.next::after{content:none}
    }
    @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
  </style>
  <Fragment set:html={analyticsBeacon()} />
</body>
</html>
