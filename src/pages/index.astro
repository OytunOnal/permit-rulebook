---
import "../../tokens.css";
import rawDataset from "visa-rules/data/dataset.json";
import { assertValidDataset } from "visa-rules/validate";
import { datasetMeta } from "visa-rules";

// Boundary validation: an invalid dataset must kill the build, loudly.
const dataset = assertValidDataset(rawDataset);
const meta = datasetMeta(dataset);
console.log(JSON.stringify({ level: "info", msg: "dataset valid at build boundary", ...meta }));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Which European work-permit routes do you appear to meet? Deterministic check against dated, source-quoted official rules. Your answers never leave this device." />
  <title>Visa Navigator — which work-permit routes fit?</title>
</head>
<body>
  <div class="wrap">
    <header>
      <div class="brand">Visa Navigator · Eligibility record</div>
      <h1 id="headline">Which work-permit routes could fit? <b>A few quick questions.</b></h1>
      <p class="sub" id="subline">Code compares your answers against published rules — every value shows its
      official quote and the date we read it from the source. Your answers never leave this device.
      At the end: which routes (visa types) look open, how close the near-misses are, and which
      single step would unlock more. It stops as soon as nothing left to ask could change your result.</p>
      <div class="stamp" aria-hidden="true" id="stamp" hidden>Record generated<b id="stamp-date"></b></div>
    </header>

    <div id="app" class="cols" data-state="questions">
      <aside class="decl" id="decl" aria-label="Your answers">
        <h2>You declared</h2>
        <dl id="decl-list"></dl>
        <a class="edit" href="#" id="restart" hidden>Start over</a>
      </aside>
      <main id="main"></main>
    </div>

    <footer>
      <p>Visa Navigator makes no immigration decision and authorities won't consider these results —
      the tool compares published values with what you declared, nothing more.</p>
      <div class="health">
        <span>dataset {meta.dataset_version}</span>
        <span>schema {meta.schema_version}</span>
        <span>newest value read {meta.newest_retrieved_at}</span>
      </div>
    </footer>
  </div>

  <script>
    import dataset from "visa-rules/data/dataset.json";
    import {
      deriveQuestions, remainingQuestions, evaluate, formatEUR, formatEURPer, routeProvenance,
      thresholdsForField, deriveBands, unlocks, notices, referencedFields, forEachCriterion, fieldOptions, matchOptions,
      countryClasses,
      type Criterion, type Dataset, type FieldOption, type Notice, type Profile, type RouteResult,
    } from "visa-rules";

    const ds = dataset as unknown as Dataset;
    // One field-lookup idiom for the whole page: the dataset never changes
    // after load, and six copies of the same scan drift (review).
    const fieldById = new Map(ds.fields.map((f) => [f.id, f]));
    const fieldOf = (id: string) => fieldById.get(id);
    const questions = deriveQuestions(ds);
    const main = document.getElementById("main")!;
    const declList = document.getElementById("decl-list")!;
    const restart = document.getElementById("restart")!;
    const headline = document.getElementById("headline")!;
    const subline = document.getElementById("subline")!;
    const app = document.getElementById("app")!;

    // The stamp belongs to the finished record — it appears with the results
    // (a "record generated" mark on question 1 stamps nothing).
    const stamp = document.getElementById("stamp")!;
    document.getElementById("stamp-date")!.textContent =
      new Date().toLocaleDateString("en-GB", { day: "2-digit", month: "2-digit", year: "numeric" }).replaceAll("/", " · ");

    const SHORT: Record<string, string> = {
      destination: "Destination", situation_country: "Offer country",
      citizenship: "Passport", situation: "Situation", qualification: "Qualification",
      recognition_de: "Recognition", experience: "Experience",
      occupation_shortage: "Shortage list", occupation_it: "IT work",
      salary_eur_year: "Salary", salary_eur_month: "Monthly salary", german: "German",
      english: "English", age_band: "Age", de_stay6m: "Stay in DE",
      partner_ck: "Partner", funds_eur_month: "Monthly funds",
      fr_degree: "French degree", experience_7y: "3 yrs in last 7",
      nl_recent_grad: "Dutch graduate", top200_grad: "Top-200 graduate",
      qualification_recent: "Recent qualification",
      fr_innovative_employer: "Innovative employer", fr_local_contract: "French contract",
    };
    const STATUS_LABEL = { met: "Criteria met", near: "Within reach", hold: "Not yet" } as const;

    let answers: Profile = {};
    let history: string[] = []; // answered fields, in order, for Back

    // The count is the whole field set, which nobody answers: pruning stops
    // the interview as soon as no remaining question could change a verdict.
    // The per-question meta carries the real number, and it shrinks (tracker #2).
    const introHeadline = () =>
      `Which work-permit routes could fit? <b>A few quick questions.</b>`;
    headline.innerHTML = introHeadline();

    function esc(s: string) {
      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    /** A field's answer set. Some fields declare their options by reference
     * (the country list lives in its own file), so the engine's own accessor is
     * the single place the page reads them — the derived question would hand
     * back band pseudo-options for money fields (review). */
    const optionsOf = (field: string): FieldOption[] => fieldOptions(ds, field);

    // s5c: above a dozen options the question becomes a filter over a list
    // instead of a wall of buttons; at or below a dozen, nothing changes.
    const LONG_LIST_ABOVE = 12;
    const LONG_LIST_SHOWN = 60;

    /** What an option's class reads as beside it. Derived from the dataset —
     * the class the option implies, or the fact that a notice would fire on
     * this answer — never a string keyed to one country. */
    function classHint(field: string, o: FieldOption): string {
      // A notice that adds rights says so in its own title; naming one treaty
      // here would print the wrong one for the next agreement (review).
      const extra = notices(ds, { [field]: o.value }).find((n) => n.kind === "extra-rights");
      if (extra) return "a note applies to this passport";
      const cls = o.implies?.[0];
      return cls ? (countryClasses[cls]?.label ?? cls) : "";
    }

    // The ledger grows as the record accrues: answered rows accumulate and
    // only the question currently on the table shows as a pending row. With
    // adaptive pruning, fields that never get asked never appear — the panel
    // promises nothing it won't deliver.
    function renderDeclaration(currentField: string | null) {
      // Rows in the order they were asked; the pending row appends last.
      // Answered rows are edit points: clicking one resumes the interview at
      // that question, keeping everything before it (a full reset destroyed
      // every answer — human catch, golden G3).
      const fields = currentField ? [...history, currentField] : history;
      declList.innerHTML = fields.map((f) => {
        const q = questions.find((qq) => qq.field === f)!;
        const opt = q.options.find((o) => o.value === answers[f]);
        return opt
          ? `<div class="done" data-field="${esc(f)}" role="button" tabindex="0" title="Change this answer"><dt>${esc(SHORT[f] ?? f)}</dt><dd>${esc(opt.label)} <span class="pen" aria-hidden="true">✎</span></dd></div>`
          : `<div><dt>${esc(SHORT[f] ?? f)}</dt><dd class="pending">—</dd></div>`;
      }).join("");
      declList.querySelectorAll<HTMLElement>("[data-field]").forEach((row) => {
        const jump = () => {
          const f = row.dataset.field!;
          const i = history.indexOf(f);
          if (i < 0) return;
          for (const later of history.slice(i)) delete answers[later];
          history = history.slice(0, i);
          stamp.hidden = true;
          app.dataset.state = "questions";
          headline.innerHTML = introHeadline();
          renderQuestion();
        };
        row.addEventListener("click", jump);
        row.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); jump(); } });
      });
      restart.hidden = currentField !== null;
    }

    function renderQuestion() {
      // Only questions a still-alive route cares about; e.g. "no job offer"
      // retires the salary question instead of asking it into the void.
      const remaining = remainingQuestions(ds, answers);
      if (remaining.length === 0) return renderResults();
      const q = remaining[0];
      renderDeclaration(q.field);
      const total = history.length + remaining.length;
      const answer = (value: string) => {
        answers[q.field] = value;
        history.push(q.field);
        renderQuestion();
      };
      // A list this long is a search, not a choice between buttons — but it is
      // still a choice from the dataset's own options: no free text, no
      // guessing at spellings.
      const longList = q.options.length > LONG_LIST_ABOVE;
      const classed = q.options.some((o) => o.implies !== undefined);
      main.innerHTML = `
        <section class="qcard">
          <div class="qmeta" role="status" aria-live="polite">Question ${history.length + 1} of up to ${total}</div>
          <h2 class="qlabel">${esc(q.label)}</h2>
          ${longList ? `
            <div class="csearch">
              <span class="mag" aria-hidden="true">⌕</span>
              <input type="text" id="cfilter" autocomplete="off" spellcheck="false"
                aria-label="Search the list" aria-controls="clist" placeholder="Start typing…">
            </div>
            <div class="clist" id="clist" aria-label="${esc(q.label)}"></div>
            <p class="visually-hidden" id="cstatus" role="status" aria-live="polite"></p>
            ${classed ? `<p class="hint">Every non-EU passport is checked against the same rules. A few countries
              have agreements that add rights on top — those are stated with their source when they apply to you.</p>` : ""}`
          : `<div class="opts">
            ${q.options.map((o) => `<button class="opt" data-value="${esc(o.value)}">${esc(o.label)}</button>`).join("")}
          </div>`}
          ${history.length > 0 ? `<button class="back" id="back">← Back</button>` : ""}
        </section>`;

      if (longList) {
        const filter = document.getElementById("cfilter") as HTMLInputElement;
        const list = document.getElementById("clist")!;
        const draw = () => {
          const needle = filter.value.trim();
          // Aliases are searched, never shown: a person typing the name they
          // grew up with ("Turkey", "Holland") must find their country, and the
          // label they then see is the official one (product-critique). The
          // matcher lives in the engine, where the promise has a test.
          if (!needle) {
            // Before aliases existed the cold list was the only escape hatch
            // for someone who could not spell the official name; now typing
            // finds them, so opening on sixty rows is just noise (tracker #4).
            list.innerHTML = `<p class="cnone">${q.options.length} countries — former names work too, try &ldquo;Holland&rdquo;.</p>`;
            const s0 = document.getElementById("cstatus");
            if (s0) s0.textContent = "";
            return;
          }
          const matches = matchOptions(q.options, needle);
          if (!matches.length) {
            // An empty box says nothing; this says what to do about it.
            list.innerHTML = `<p class="cnone">No country matches. Try fewer letters, or the country's own name.</p>`;
            return;
          }
          const status = document.getElementById("cstatus");
          if (status) status.textContent = `${matches.length} match${matches.length === 1 ? "" : "es"}`;
          const shown = matches.slice(0, LONG_LIST_SHOWN);
          const highlight = filter.value.trim() !== "";
          list.innerHTML = shown.map((o, i) =>
            `<button class="copt${i === 0 && highlight ? " on" : ""}" data-value="${esc(o.value)}"><span>${esc(o.label)}</span>${
              classed ? `<span class="cls">${esc(classHint(q.field, o))}</span>` : ""}</button>`).join("") +
            (matches.length > shown.length
              ? `<p class="cmore">${matches.length - shown.length} more — keep typing to narrow the list</p>`
              : "");
          list.querySelectorAll<HTMLButtonElement>(".copt").forEach((b) =>
            b.addEventListener("click", () => answer(b.dataset.value!)));
        };
        filter.addEventListener("input", draw);
        filter.addEventListener("keydown", (e) => {
          // Enter takes the highlighted row — but only once typing has narrowed
          // the list to it. On an untouched box the first row is the first
          // country in the alphabet, and a habitual Enter would answer
          // "Afghanistan" for someone who never chose it (review).
          // isComposing: an IME's committing Enter belongs to the IME.
          if (e.key !== "Enter" || e.isComposing) return;
          e.preventDefault();
          if (!filter.value.trim()) return;
          const first = list.querySelector<HTMLButtonElement>(".copt");
          if (first) answer(first.dataset.value!);
        });
        draw();
        filter.focus();
      } else {
        main.querySelectorAll<HTMLButtonElement>(".opt").forEach((btn) =>
          btn.addEventListener("click", () => answer(btn.dataset.value!)));
      }

      document.getElementById("back")?.addEventListener("click", () => {
        const last = history.pop();
        if (last) delete answers[last];
        renderQuestion();
      });
    }

    function railFor(result: RouteResult): string {
      // Nested too: NL ICT states its thresholds inside an any-disjunction, so
      // a top-level-only scan drew no rail on exactly those near cards (review).
      const salary = gapCriterionOf(result) ??
        gteCriteriaOf(result).find((c) => answers[c.field] !== undefined);
      if (!salary) return "";
      const field = salary.field;
      const ts = thresholdsForField(ds, field);
      const bands = deriveBands(ds, field);
      const band = bands.find((b) => b.id === answers[field]);
      if (!band || ts.length === 0) return "";
      const lo = Math.min(...ts) * 0.88, hi = Math.max(...ts) * 1.1;
      const pct = (v: number) => Math.max(2, Math.min(98, ((v - lo) / (hi - lo)) * 100));
      const bMin = pct(band.min ?? lo), bMax = pct(band.max ?? hi);
      const ticks = ts.map((t) => `<span class="tick" style="left:${pct(t)}%" title="${formatEUR(t)} — a threshold on another route"></span>`).join("");
      // Label only this route's own threshold — neighbouring ticks stay as
      // unlabeled context so close thresholds can't collide.
      const own = salary.threshold.amount;
      const labels = `<span class="lbl" style="left:${pct(own)}%"><b>${formatEUR(own)}</b>${
        salary.threshold_label ? esc(salary.threshold_label) : ""}</span>`;
      // The two labels overprint when the band meets the threshold (critique
      // #10). Shifting sideways only moved the collision — the labels are
      // wider than the narrow bands — so the second label drops to its own
      // line, where no width can bring them back together.
      const centre = (bMin + bMax) / 2;
      const collides = Math.abs(pct(own) - centre) < 14;
      const youStyle = `left:${centre}%;top:${collides ? "2.5rem" : "1.35rem"}`;
      return `
        <div class="rail" aria-label="Salary thresholds">
          <div class="bar"><span class="you" style="left:${bMin}%;width:${bMax - bMin}%"></span>${ticks}</div>
          <div class="lbls">${labels}
            <span class="lbl you-l" style="${youStyle}"><b>your band</b></span>
          </div>
        </div>`;
    }

    type CritResult = RouteResult["criteria"][number];

    /**
     * A criterion the user "failed" by having more: the route wants the
     * "none of these" answer (Chancenkarte: no offer yet) and the user
     * declared a real step. "Not met: situation" reads to an offer-holder as
     * "lose your offer" — the honest line names what they already have.
     */
    function notNeededWith(cr: CritResult): string | null {
      const c = cr.criterion;
      if (c.op !== "eq") return null;
      const def = fieldOf(c.field);
      const required = optionsOf(c.field).find((o) => o.value === c.value);
      const declared = optionsOf(c.field).find((o) => o.value === answers[c.field]);
      return required?.is_fallback && declared?.short ? declared.short : null;
    }

    /** How a failing criterion names itself in a verdict line. The field name
     * alone ("age") reads as a verdict on the person, so the dataset's
     * short_reason qualifies it ("age — for 30 or older"). */
    function failLabel(cr: CritResult): string {
      const c = cr.criterion;
      const base =
        c.op === "any" ? (c.label ?? "requirements") :
        c.op === "points" ? "points requirement" :
        (SHORT[c.field] ?? c.field);
      return c.short_reason ? `${base} — ${c.short_reason}` : base;
    }

    /** Unknowns the user can still act on: on a hard-failed route nothing the
     * person finds out can change the verdict, so none of them is open. Every
     * consumer (verdict line, strip count, auto-open, learn box) reads this one
     * list, or they contradict each other on the same row (review). */
    function liveUnknowns(r: RouteResult): string[] {
      if (r.hard_fail) return [];
      return r.unknown_fields.filter((f) => answers[f] !== undefined);
    }
    const hasLiveUnknown = (r: RouteResult) => liveUnknowns(r).length > 0;

    /** Every gte criterion in a route, at any depth. */
    function gteCriteriaOf(r: RouteResult): Extract<Criterion, { op: "gte" }>[] {
      const out: Extract<Criterion, { op: "gte" }>[] = [];
      forEachCriterion(r.route.criteria, (c) => { if (c.op === "gte") out.push(c); });
      return out;
    }

    /** The gte criterion a bounded gap was measured on — matched by amount, so
     * a gap propagated out of a disjunction still finds its field (review). */
    function gapCriterionOf(r: RouteResult): Extract<Criterion, { op: "gte" }> | undefined {
      if (r.gap_max === undefined) return undefined;
      return gteCriteriaOf(r).find((c) => {
        const band = deriveBands(ds, c.field).find((b) => b.id === answers[c.field]);
        return band !== undefined && Math.abs(c.threshold.amount - (band.min ?? 0) - r.gap_max!) < 0.005;
      });
    }

    function whyFor(r: RouteResult): string {
      if (r.status === "met") return esc(r.route.summary ?? "All published criteria appear met by your declaration.");
      if (r.status === "near")
        return r.gap_points
          ? "The points requirement is within reach — the ladder below shows your score."
          : "The threshold sits above your declared band.";
      const fails = r.criteria.filter((c) => c.outcome === "fail");
      const moot: string[] = [], missing: string[] = [];
      for (const cr of fails) {
        const m = notNeededWith(cr);
        if (m) moot.push(m); else missing.push(failLabel(cr));
      }
      const unknown = liveUnknowns(r).map((f) => SHORT[f] ?? f);
      const parts = [];
      if (moot.length) parts.push(`Not needed with ${moot.join(", ")}.`);
      if (missing.length) parts.push(`Not met: ${missing.join(", ").toLowerCase()}.`);
      if (unknown.length) parts.push(`Unknown (you answered "I don't know"): ${unknown.join(", ").toLowerCase()} — an open gap, not a no.`);
      return esc(parts.join(" "));
    }

    /** Conditions the authority applies that the interview never asked —
     * stated on every card so "criteria met" cannot overpromise. */
    function precondFor(r: RouteResult): string {
      const items = r.route.preconditions;
      if (!items?.length) return "";
      return `<div class="precond"><b>Also required — not checked here:</b> ${
        items.map((t) => esc(t)).join(" · ")}</div>`;
    }

    function provenanceFor(r: RouteResult): string {
      const lines = routeProvenance(r.route).map(({ label, value }) => {
        const host = new URL(value.source_url).hostname.replace(/^www\./, "");
        return `<div class="src"><i>“${esc(value.quote)}”</i> · ${esc(host)}${label ? ` · ${esc(label)}` : ""}${
          value.legal_basis ? ` · ${esc(value.legal_basis)}` : ""} · <b>read ${esc(value.retrieved_at)}</b></div>`;
      });
      return lines.length ? `<div class="srcs">${lines.join("")}</div>` : "";
    }

    // s3: "I don't know" answers get an official find-out link — driven by the
    // dataset's field `learn` sources, never hardcoded in the UI.
    function learnBoxFor(r: RouteResult): string {
      // Only where the unknown still binds: on a hard-failed route (wrong
      // qualification, no offer) finding out changes nothing, and the link
      // sends the user down a path that cannot open (critique #4).
      const links = liveUnknowns(r)
        .map((f) => fieldOf(f)?.learn)
        .filter((l): l is { label: string; url: string } => !!l);
      if (!links.length) return "";
      return `<div class="learn">You can find out yourself: ${links
        .map((l) => `<a href="${esc(l.url)}" target="_blank" rel="noopener">${esc(l.label)}</a>`)
        .join(" · ")}.</div>`;
    }

    const periodOf = (field: string) => fieldOf(field)?.period;

    /** The money field a route's bounded gap is measured on — its period is
     * what makes "€1,585" readable as monthly or annual (critique #7). */
    const gapFieldOf = (r: RouteResult) => gapCriterionOf(r)?.field ?? "";

    /** One gap, one format, everywhere it is printed (card, headline, unlock). */
    const gapAmount = (r: RouteResult) =>
      formatEURPer(Math.round(r.gap_max!), periodOf(gapFieldOf(r)));

    function optLabel(field: string, value: string | undefined): string {
      if (value === undefined) return "no answer";
      if (fieldOf(field)?.type === "money_band")
        return deriveBands(ds, field).find((b) => b.id === value)?.label ?? value;
      return optionsOf(field).find((o) => o.value === value)?.label ?? value;
    }

    // Expanded hold rows: per-criterion "needs X — you declared Y" lines, so
    // "Not met: qualification" always unfolds into something concrete.
    function failDetail(r: RouteResult): string {
      const rows = r.criteria
        .filter((cr) => cr.outcome === "fail")
        .map((cr) => {
          const c = cr.criterion;
          const moot = notNeededWith(cr);
          if (moot) return `<li class="moot"><b>Not needed</b> — you already have ${esc(moot)}</li>`;
          if (c.op === "any")
            return `<li><b>${esc(failLabel(cr))}</b> — no qualifying path (${esc(c.paths.map((p) => p.label ?? "path").join(" / "))})</li>`;
          const req =
            c.op === "eq" ? optLabel(c.field, c.value) :
            c.op === "in" ? c.values.map((v) => optLabel(c.field, v)).join(" or ") :
            c.op === "gte" ? `${formatEURPer(c.threshold.amount, periodOf(c.field))} or more` :
            `${c.required.value} points`;
          const field = "field" in c ? c.field : "";
          return `<li><b>${esc(failLabel(cr))}</b> — needs: ${esc(req)} · you declared: ${esc(optLabel(field, answers[field]))}</li>`;
        });
      return rows.length ? `<ul class="faildetail">${rows.join("")}</ul>` : "";
    }

    function fullCard(r: RouteResult, showCountry = true): string {
      return `
        <article class="route">
          <div class="top">
            <div>${showCountry ? `<span class="country">${esc(ds.countries.find((c) => c.code === r.country)?.name ?? r.country)}</span>` : ""}
              <h3>${esc(r.route.name)}</h3></div>
            <span class="st ${r.status}">${STATUS_LABEL[r.status]}</span>
          </div>
          <p class="why">${whyFor(r)}</p>
          ${precondFor(r)}
          ${r.points ? `<div class="ptsline"><b>Points ${r.points.scored} of ${r.points.required}</b>${
            r.points.items.length ? " — " + r.points.items.map((i) => `${esc(SHORT[i.field] ?? i.field)} +${i.points}`).join(" · ") : ""
          }</div>` : ""}
          ${r.status !== "hold" ? railFor(r) : ""}
          ${r.status === "near" && r.gap_max ? (() => {
            const gapField = gapFieldOf(r);
            const hint = gapField === "salary_eur_year"
              ? " A route with a lower threshold may already apply — check the other cards."
              : "";
            const label = gapField ? ` — ${esc((SHORT[gapField] ?? gapField).toLowerCase())}` : "";
            return `<div class="gapnote"><b>Gap: up to ${gapAmount(r)}</b>${label}.${hint}</div>`;
          })() : ""}
          ${r.status === "near" && r.gap_points ? `<div class="gapnote"><b>Gap: ${r.gap_points} point${r.gap_points === 1 ? "" : "s"} short.</b> The sourced points table shows where more can come from — language level, experience and age all score.</div>` : ""}
          ${learnBoxFor(r)}
          <div class="foot">${provenanceFor(r)}<a class="next" href="${esc(r.route.info_url)}" target="_blank" rel="noopener">Official page</a></div>
        </article>`;
    }

    function holdRow(r: RouteResult): string {
      const why = whyFor(r);
      const short = why.split(". ")[0].replace(/\.$/, "");
      // Auto-open only where the unknown still binds — a row opened on a dead
      // route promises an answer that cannot change it (critique #4).
      return `
        <details class="route-hold"${hasLiveUnknown(r) ? " open" : ""}>
          <summary><span class="country">${esc(r.country)}</span><span class="hold-name">${esc(r.route.name)}</span><span class="hold-why">${short}</span></summary>
          <div class="hold-body">
            ${r.route.summary ? `<p class="why">${esc(r.route.summary)}</p>` : ""}
            ${precondFor(r)}
            ${failDetail(r)}
            ${learnBoxFor(r)}
            <div class="foot">${provenanceFor(r)}<a class="next" href="${esc(r.route.info_url)}" target="_blank" rel="noopener">Official page</a></div>
          </div>
        </details>`;
    }

    /** Every failing criterion of this row sits on a step the user hasn't
     * taken (an offer, a transfer, a hosting agreement) and nothing else is
     * open on it — the row says only what the step above already says. */
    function isStepGated(r: RouteResult): boolean {
      const fails = r.criteria.filter((c) => c.outcome === "fail");
      if (!fails.length || hasLiveUnknown(r)) return false;
      // "Not needed with a job offer" is the opposite story — never file a
      // route the user has outgrown under "needs a job offer".
      if (fails.some((cr) => notNeededWith(cr) !== null)) return false;
      return fails.every((cr) => {
        const fields = referencedFields(cr.criterion);
        // A criterion referencing no field is not "path-gated" — engine parity.
        return fields.length > 0 && fields.every((f) => fieldOf(f)?.kind === "path");
      });
    }

    /** The steps a set of gated rows actually asks for, named by the dataset.
     * Fixed copy ("a job offer, transfer or hosting agreement") told a user who
     * had declared a transfer that they needed one (review). */
    function stepNamesFor(rows: RouteResult[]): string[] {
      const names = new Set<string>();
      for (const r of rows)
        for (const cr of r.criteria.filter((c) => c.outcome === "fail")) {
          const c = cr.criterion;
          if (!("field" in c)) continue;
          const def = fieldOf(c.field);
          if (def?.kind !== "path") continue;
          const wanted = c.op === "eq" ? [c.value] : c.op === "in" ? c.values : [];
          for (const v of wanted) {
            const opt = optionsOf(c.field).find((o) => o.value === v);
            if (opt && !opt.is_fallback) names.add(opt.short ?? opt.label);
          }
        }
      return [...names];
    }

    const joinOr = (xs: string[]) =>
      xs.length < 2 ? (xs[0] ?? "") : `${xs.slice(0, -1).join(", ")} or ${xs.at(-1)}`;

    /**
     * One "Not met: situation" row per country was information; sixteen were
     * noise (critique #5). Rows gated on the step alone collapse into one
     * group; anything with its own reason keeps its own row.
     */
    function holdList(rows: RouteResult[], hasUnlocks: boolean): string {
      const gated: RouteResult[] = [], individual: RouteResult[] = [];
      for (const r of rows) (isStepGated(r) ? gated : individual).push(r);
      if (gated.length < 3) return rows.map(holdRow).join("");
      const steps = joinOr(stepNamesFor(gated));
      return individual.map(holdRow).join("") +
        `<details class="hold-group">
          <summary>${gated.length} routes need ${esc(steps)}${
            hasUnlocks ? " — see the steps above" : ""}</summary>
          <div class="hold-group-body">${gated.map(holdRow).join("")}</div>
        </details>`;
    }

    /** A quote long enough to bury the card is shown to its first sentence,
     * with the whole passage on the element and its source a click away — the
     * evidence stays complete, the card stays readable (tracker #5). */
    function quoteForCard(quote: string): { shown: string; trimmed: boolean } {
      if (quote.length <= 200) return { shown: quote, trimmed: false };
      const end = quote.indexOf(". ");
      if (end < 0 || end > 200) return { shown: quote.slice(0, 200).trimEnd() + "…", trimmed: true };
      return { shown: quote.slice(0, end + 1) + " …", trimmed: true };
    }

    function noticeCard(n: Notice): string {
      const host = new URL(n.source.source_url).hostname.replace(/^www\./, "");
      return `
        <article class="notice ${esc(n.kind)}">
          <h3>${esc(n.title)}</h3>
          <p class="why">${esc(n.body)}</p>
          <div class="foot">
            <div class="srcs"><div class="src"${
              quoteForCard(n.source.quote).trimmed ? ` title="${esc(n.source.quote)}"` : ""
            }><i>“${esc(quoteForCard(n.source.quote).shown)}”</i> · ${esc(host)}${
              n.source.legal_basis ? ` · ${esc(n.source.legal_basis)}` : ""} · <b>read ${esc(n.source.retrieved_at)}</b></div></div>
            <a class="next" href="${esc(n.source.source_url)}" target="_blank" rel="noopener">Official page</a>
          </div>
        </article>`;
    }

    function unlockTitle(u: ReturnType<typeof unlocks>[number]): string {
      const def = fieldOf(u.field);
      let title = (u.option.short ?? u.option.label) +
        (def?.type === "money_band" ? ` — ${(SHORT[u.field] ?? u.field).toLowerCase()}` : "");
      if (u.qualifier)
        title += u.qualifier.field === "situation_country"
          ? ` in ${u.qualifier.option.label}`
          : ` · ${u.qualifier.option.label}`;
      return title;
    }

    function unlockCard(u: ReturnType<typeof unlocks>[number], routes: RouteResult[]): string {
      return `
        <article class="unlock">
          <h4>With <b>${esc(unlockTitle(u))}</b></h4>
          <ul>${routes.map((r) =>
            `<li>${esc(r.route.name)} — ${r.status === "met"
              ? `<b>would be met</b>`
              : `<i>would come within reach${r.gap_max ? ` (${gapAmount(r)})` : r.gap_points ? ` (${r.gap_points} pt${r.gap_points === 1 ? "" : "s"} more)` : ""}</i>`}</li>`).join("")}
          </ul>
        </article>`;
    }

    function renderResults() {
      // s5: countries the destination answer rules out disappear entirely —
      // their routes fail on a fact the user chose, which is not information.
      const dest = answers["destination"];
      const visible = ds.countries.filter((c) =>
        dest === undefined || dest === "all" || c.code.toLowerCase() === dest);
      const visibleCodes = new Set(visible.map((c) => c.code));
      const results = evaluate(ds, answers).filter((r) => visibleCodes.has(r.country));

      const byStatus = {
        met: results.filter((r) => r.status === "met"),
        near: results.filter((r) => r.status === "near"),
        hold: results.filter((r) => r.status === "hold"),
      };
      const met = byStatus.met.length;
      const near = byStatus.near;
      const metCountries = new Set(byStatus.met.map((r) => r.country));

      renderDeclaration(null);
      app.dataset.state = "results";
      stamp.hidden = false;

      const applicable = notices(ds, answers);
      const zeroOpen = met + near.length === 0;
      const baseSub = `Code compared your ${history.length} answer${history.length === 1 ? "" : "s"} against ${results.length} published rule sets. ` +
        `Every value below shows its official quote and the date we read it from the source.`;

      // The screen no route can produce: this passport needs no permit at all.
      // "0 routes look open" is the worst news for the best-placed user and it
      // isn't even true (critique #1) — here the notice IS the result.
      // Only a notice that ANSWERS instead of the routes may take the screen:
      // "you need no permit at all" is the whole story. An extra-rights notice
      // adds to a verdict the rules computed, so it never suppresses one — the
      // zero-open screen keeps its headline and its unlocking steps (s5c).
      const replacing = applicable.filter((n) => n.kind === "no-permit-needed");
      if (replacing.length && zeroOpen) {
        // The headline is the notice's own title: a second copy of it here
        // would drift the moment the dataset states a different notice.
        headline.innerHTML = esc(replacing[0].title) + ".";
        subline.textContent = "Nothing to compare: the published rule below answers your situation directly.";
        // Any other applicable notice still belongs on the screen — dropping
        // it silenced, say, the Türkiye note (review).
        main.innerHTML = [...replacing, ...applicable.filter((n) => !replacing.includes(n))]
          .map(noticeCard).join("");
        return;
      }

      // s3b: counterfactual leverage — what each alternative step would unlock.
      const ups = unlocks(ds, answers);
      // Notices ride above the normal layout, with the results intact.
      const noticeCards = applicable.map(noticeCard).join("");

      if (zeroOpen && ups.length) {
        // The step worth naming: one that would fully meet a route beats one
        // that only brings routes within reach, then breadth, then dataset
        // order (strict >, so ties keep the engine's order).
        const rank = (u: (typeof ups)[number]) =>
          (u.routes.some((r) => r.status === "met") ? 1e6 : 0) + u.routes.length;
        const bestUp = ups.reduce((best, u) => (rank(u) > rank(best) ? u : best));
        // Zero open is a starting point, not a dead end — the steps are the news.
        headline.innerHTML = `Nothing open yet — ${ups.length} step${ups.length === 1 ? "" : "s"} would change that.`;
        subline.textContent = `${baseSub} Nearest: ${unlockTitle(bestUp)}.`;
      } else if (zeroOpen) {
        // Nothing open and no single step would open one: no false hope.
        headline.innerHTML = "Nothing open on these answers.";
        subline.textContent = `${baseSub} Change an answer on the left to explore — or see each country's reasons below.`;
      } else {
        const nearNote = near.length
          ? near[0].gap_max
            ? ` <b>One is within ${gapAmount(near[0])}.</b>`
            : near[0].gap_points
              ? ` <b>One is ${near[0].gap_points} point${near[0].gap_points === 1 ? "" : "s"} away.</b>`
              : ""
          : "";
        const across = metCountries.size > 1 ? ` across ${metCountries.size} countries` : "";
        headline.innerHTML = `${met} route${met === 1 ? "" : "s"} look${met === 1 ? "s" : ""} open${across}.` + nearNote;
        subline.textContent = baseSub;
      }

      // Counted the way the rows read: an unknown on a hard-failed route is
      // moot, and no learn box offers to resolve it (critique #4).
      const openUnknownCount = (rs: RouteResult[]) => rs.filter(hasLiveUnknown).length;
      const openUnknowns = openUnknownCount(results);

      const strip = `<div class="strip" aria-label="Summary">
          <span class="s-met">${byStatus.met.length} open</span>
          <span class="s-near">${byStatus.near.length} within reach</span>
          <span class="s-hold">${byStatus.hold.length} not yet${openUnknowns ? ` — ${openUnknowns} ${openUnknowns === 1 ? "has" : "have"} an open unknown` : ""}</span>
        </div>`;

      const section = (title: string, cls: string, inner: string, count: number) =>
        count ? `<div class="ghead ${cls}"><b>${title}</b> (${count})</div><div class="stack">${inner}</div>` : "";

      const seekHint = (rs: RouteResult[], hasUnlocks: boolean) =>
        hasUnlocks && rs.some((r) => r.route.kind === "seek" && r.status !== "hold")
          ? `<p class="unlock-hint">Your job-search permit above is exactly for this — lawful time in the country to land that offer.</p>`
          : "";

      if (visible.length === 1) {
        // Single destination: the flat s3 layout, no country chrome.
        const unlockSection = ups.length
          ? `<div class="ghead unlockh"><b>Steps that would unlock more</b> — each re-checked against the rules</div>` +
            ups.map((u) => unlockCard(u, u.routes)).join("") +
            seekHint(results, true)
          : "";
        main.innerHTML = noticeCards + strip +
          section("Open — criteria met", "", byStatus.met.map((r) => fullCard(r)).join(""), byStatus.met.length) +
          section("Within reach", "near", byStatus.near.map((r) => fullCard(r)).join(""), byStatus.near.length) +
          unlockSection +
          section("Not yet", "hold", holdList(byStatus.hold, ups.length > 0), byStatus.hold.length);
        return;
      }

      // Multi destination: collapsible country sections; hopeful countries open,
      // all-hold ones collapsed with the tally (and any unlocking steps) visible.
      // With nothing open anywhere, the first country that has steps opens
      // instead — the hope is the point, and it was hidden in 10px tally text.
      const withUps = new Set(ups.flatMap((u) => u.routes.map((r) => r.country)));
      const firstWithUps = visible.find((c) => withUps.has(c.code))?.code;
      main.innerHTML = noticeCards + strip + visible.map((c) => {
        const rs = results.filter((r) => r.country === c.code);
        const g = {
          met: rs.filter((r) => r.status === "met"),
          near: rs.filter((r) => r.status === "near"),
          hold: rs.filter((r) => r.status === "hold"),
        };
        // Country-scoped unlock rows: each row's routes narrowed to this country.
        const cUps = ups
          .map((u) => ({ u, routes: u.routes.filter((r) => r.country === c.code) }))
          .filter((x) => x.routes.length);
        const unknowns = openUnknownCount(rs);
        const tallyParts = [
          g.met.length ? `${g.met.length} open` : "",
          g.near.length ? `${g.near.length} within reach` : "",
          g.hold.length ? `${g.hold.length} not yet${unknowns ? ` — ${unknowns} ${unknowns === 1 ? "has" : "have"} an open unknown` : ""}` : "",
          cUps.length ? `<i>${cUps.length} unlocking step${cUps.length === 1 ? "" : "s"}</i>` : "",
        ].filter(Boolean).join(" · ");
        const open = g.met.length + g.near.length > 0 || (zeroOpen && c.code === firstWithUps);
        const inner =
          section("Open — criteria met", "", g.met.map((r) => fullCard(r, false)).join(""), g.met.length) +
          section("Within reach", "near", g.near.map((r) => fullCard(r, false)).join(""), g.near.length) +
          (cUps.length
            ? `<div class="ghead unlockh"><b>Steps that would unlock more here</b></div>` +
              cUps.map((x) => unlockCard(x.u, x.routes)).join("") +
              seekHint(rs, true)
            : "") +
          section("Not yet", "hold", holdList(g.hold, cUps.length > 0), g.hold.length);
        return `<details class="country-sec"${open ? " open" : ""}>
            <summary>${esc(c.name)} <span class="tally">${tallyParts}</span></summary>
            <div class="cbody">${inner}</div>
          </details>`;
      }).join("");
    }

    restart.addEventListener("click", (e) => {
      e.preventDefault();
      answers = {}; history = [];
      app.dataset.state = "questions";
      stamp.hidden = true;
      headline.innerHTML = introHeadline();
      renderQuestion();
    });

    // Dev-only screenshot hook (stripped from production builds): pre-fill a
    // profile via ?dev-profile={"destination":"de",...} to land on any screen.
    if (import.meta.env.DEV) {
      const raw = new URLSearchParams(location.search).get("dev-profile");
      if (raw) {
        try {
          answers = JSON.parse(raw);
          history = Object.keys(answers);
        } catch { /* fall through to the normal flow */ }
      }
    }

    renderQuestion();

    // Dev-only layout probe: ?dev-probe=1 writes the widest offenders into the
    // title so headless --dump-dom can report horizontal overflow (golden G1).
    if (import.meta.env.DEV && new URLSearchParams(location.search).has("dev-probe")) {
      const w = document.documentElement.clientWidth;
      const bad = [...document.querySelectorAll<HTMLElement>("body *")]
        .map((el) => ({ el, r: el.getBoundingClientRect() }))
        .filter((x) => x.r.right > w + 1)
        .slice(0, 8)
        .map((x) => `${x.el.tagName.toLowerCase()}.${x.el.className || "-"}:${Math.round(x.r.right)}`);
      document.title = `probe w=${w} sw=${document.documentElement.scrollWidth} | ${bad.join(" ; ")}`;
    }
  </script>

  <style is:global>
