---
import "../../tokens.css";
import rawDataset from "visa-rules/data/de.json";
import { assertValidDataset } from "visa-rules/validate";
import { datasetMeta } from "visa-rules";

// Boundary validation: an invalid dataset must kill the build, loudly.
const dataset = assertValidDataset(rawDataset);
const meta = datasetMeta(dataset);
console.log(JSON.stringify({ level: "info", msg: "dataset valid at build boundary", ...meta }));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Which European work-permit routes do you appear to meet? Deterministic check against dated, source-quoted official rules. Your answers never leave this device." />
  <title>Visa Navigator — which work-permit routes fit?</title>
</head>
<body>
  <div class="wrap">
    <header>
      <div class="brand">Visa Navigator · Eligibility record</div>
      <h1 id="headline">Which routes could fit? <b>A few quick questions.</b></h1>
      <p class="sub" id="subline">Code compares your answers against published rules — every value shows its
      official quote and the date it was read. Your answers never leave this device.</p>
      <div class="stamp" aria-hidden="true">Record generated<b id="stamp-date"></b></div>
    </header>

    <div id="app" class="cols" data-state="questions">
      <aside class="decl" id="decl" aria-label="Your answers">
        <h2>You declared</h2>
        <dl id="decl-list"></dl>
        <a class="edit" href="#" id="restart" hidden>Change an answer</a>
      </aside>
      <main id="main"></main>
    </div>

    <footer>
      <p>Visa Navigator makes no immigration decision and authorities won't consider these results —
      the tool compares published values with what you declared, nothing more.</p>
      <div class="health">
        <span>dataset {meta.dataset_version}</span>
        <span>schema {meta.schema_version}</span>
        <span>newest value read {meta.newest_retrieved_at}</span>
      </div>
    </footer>
  </div>

  <script>
    import dataset from "visa-rules/data/de.json";
    import {
      deriveQuestions, remainingQuestions, evaluate, formatEUR, routeProvenance,
      thresholdsForField, deriveBands, unlocks, type Dataset, type Profile, type RouteResult,
    } from "visa-rules";

    const ds = dataset as unknown as Dataset;
    const questions = deriveQuestions(ds);
    const main = document.getElementById("main")!;
    const declList = document.getElementById("decl-list")!;
    const restart = document.getElementById("restart")!;
    const headline = document.getElementById("headline")!;
    const subline = document.getElementById("subline")!;
    const app = document.getElementById("app")!;

    document.getElementById("stamp-date")!.textContent =
      new Date().toLocaleDateString("en-GB", { day: "2-digit", month: "2-digit", year: "numeric" }).replaceAll("/", " · ");

    const SHORT: Record<string, string> = {
      citizenship: "Citizenship", situation: "Situation", qualification: "Qualification",
      recognition_de: "Recognition", experience: "Experience",
      occupation_shortage: "Shortage list", occupation_it: "IT work",
      salary_eur_year: "Salary", language_base: "Base language", german: "German",
      english_c1: "English C1", age_band: "Age", de_stay6m: "Stay in DE",
      partner_ck: "Partner", funds_eur_month: "Monthly funds",
    };
    const STATUS_LABEL = { met: "Criteria met", near: "Within reach", hold: "Not yet" } as const;

    let answers: Profile = {};
    let history: string[] = []; // answered fields, in order, for Back

    const introHeadline = () =>
      `Which routes could fit? <b>Up to ${questions.length} quick questions.</b>`;
    headline.innerHTML = introHeadline();

    function esc(s: string) {
      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    // The ledger grows as the record accrues: answered rows accumulate and
    // only the question currently on the table shows as a pending row. With
    // adaptive pruning, fields that never get asked never appear — the panel
    // promises nothing it won't deliver.
    function renderDeclaration(currentField: string | null) {
      // Rows in the order they were asked; the pending row appends last.
      const fields = currentField ? [...history, currentField] : history;
      declList.innerHTML = fields.map((f) => {
        const q = questions.find((qq) => qq.field === f)!;
        const opt = q.options.find((o) => o.value === answers[f]);
        return `<div><dt>${esc(SHORT[f] ?? f)}</dt><dd${opt ? "" : ` class="pending"`}>${esc(opt?.label ?? "—")}</dd></div>`;
      }).join("");
      restart.hidden = currentField !== null;
    }

    function renderQuestion() {
      // Only questions a still-alive route cares about; e.g. "no job offer"
      // retires the salary question instead of asking it into the void.
      const remaining = remainingQuestions(ds, answers);
      if (remaining.length === 0) return renderResults();
      const q = remaining[0];
      renderDeclaration(q.field);
      const total = history.length + remaining.length;
      main.innerHTML = `
        <section class="qcard" aria-live="polite">
          <div class="qmeta">Question ${history.length + 1} of up to ${total}</div>
          <h2 class="qlabel">${esc(q.label)}</h2>
          <div class="opts">
            ${q.options.map((o) => `<button class="opt" data-value="${esc(o.value)}">${esc(o.label)}</button>`).join("")}
          </div>
          ${history.length > 0 ? `<button class="back" id="back">← Back</button>` : ""}
        </section>`;
      main.querySelectorAll<HTMLButtonElement>(".opt").forEach((btn) =>
        btn.addEventListener("click", () => {
          answers[q.field] = btn.dataset.value!;
          history.push(q.field);
          renderQuestion();
        }),
      );
      document.getElementById("back")?.addEventListener("click", () => {
        const last = history.pop();
        if (last) delete answers[last];
        renderQuestion();
      });
    }

    function railFor(result: RouteResult): string {
      const salary = result.route.criteria.find((c) => c.op === "gte");
      if (!salary || salary.op !== "gte") return "";
      const field = salary.field;
      const ts = thresholdsForField(ds, field);
      const bands = deriveBands(ds, field);
      const band = bands.find((b) => b.id === answers[field]);
      if (!band || ts.length === 0) return "";
      const lo = Math.min(...ts) * 0.88, hi = Math.max(...ts) * 1.1;
      const pct = (v: number) => Math.max(2, Math.min(98, ((v - lo) / (hi - lo)) * 100));
      const bMin = pct(band.min ?? lo), bMax = pct(band.max ?? hi);
      const ticks = ts.map((t) => `<span class="tick" style="left:${pct(t)}%"></span>`).join("");
      // Label only this route's own threshold — neighbouring ticks stay as
      // unlabeled context so close thresholds can't collide.
      const own = salary.threshold.amount;
      const labels = `<span class="lbl" style="left:${pct(own)}%"><b>${formatEUR(own)}</b>${
        salary.threshold_label ? esc(salary.threshold_label) : ""}</span>`;
      return `
        <div class="rail" aria-label="Salary thresholds">
          <div class="bar"><span class="you" style="left:${bMin}%;width:${bMax - bMin}%"></span>${ticks}</div>
          <div class="lbls">${labels}
            <span class="lbl you-l" style="left:${(bMin + bMax) / 2}%;top:1.35rem"><b>your band</b></span>
          </div>
        </div>`;
    }

    function whyFor(r: RouteResult): string {
      if (r.status === "met") return esc(r.route.summary ?? "All published criteria appear met by your declaration.");
      if (r.status === "near")
        return r.gap_points
          ? "The points requirement is within reach — the ladder below shows your score."
          : "The threshold sits above your declared band.";
      const missing = r.criteria.filter((c) => c.outcome === "fail").map((c) => SHORT[c.criterion.field] ?? c.criterion.field);
      // Only fields the user explicitly answered "I don't know" — a question
      // skipped because the route was already dead is not an unknown, it was
      // never asked.
      const unknown = r.unknown_fields.filter((f) => answers[f] !== undefined).map((f) => SHORT[f] ?? f);
      const parts = [];
      if (missing.length) parts.push(`Not met: ${missing.join(", ").toLowerCase()}.`);
      if (unknown.length) parts.push(`Unknown (you answered "I don't know"): ${unknown.join(", ").toLowerCase()} — an open gap, not a no.`);
      return esc(parts.join(" "));
    }

    function provenanceFor(r: RouteResult): string {
      const lines = routeProvenance(r.route).map(({ label, value }) => {
        const host = new URL(value.source_url).hostname.replace(/^www\./, "");
        return `<div class="src"><i>“${esc(value.quote)}”</i> · ${esc(host)}${label ? ` · ${esc(label)}` : ""}${
          value.legal_basis ? ` · ${esc(value.legal_basis)}` : ""} · <b>read ${esc(value.retrieved_at)}</b></div>`;
      });
      return lines.length ? `<div class="srcs">${lines.join("")}</div>` : "";
    }

    // s3: "I don't know" answers get an official find-out link — driven by the
    // dataset's field `learn` sources, never hardcoded in the UI.
    function learnBoxFor(r: RouteResult): string {
      const links = r.unknown_fields
        .filter((f) => answers[f] !== undefined)
        .map((f) => ds.fields.find((d) => d.id === f)?.learn)
        .filter((l): l is { label: string; url: string } => !!l);
      if (!links.length) return "";
      return `<div class="learn">You can find out yourself: ${links
        .map((l) => `<a href="${esc(l.url)}" rel="noopener">${esc(l.label)}</a>`)
        .join(" · ")}.</div>`;
    }

    function optLabel(field: string, value: string | undefined): string {
      if (value === undefined) return "no answer";
      const def = ds.fields.find((d) => d.id === field);
      if (def?.type === "money_band")
        return deriveBands(ds, field).find((b) => b.id === value)?.label ?? value;
      return def?.options?.find((o) => o.value === value)?.label ?? value;
    }

    // Expanded hold rows: per-criterion "needs X — you declared Y" lines, so
    // "Not met: qualification" always unfolds into something concrete.
    function failDetail(r: RouteResult): string {
      const rows = r.criteria
        .filter((cr) => cr.outcome === "fail")
        .map((cr) => {
          const c = cr.criterion;
          if (c.op === "any")
            return `<li><b>${esc(c.label ?? "requirements")}</b> — no qualifying path (${esc(c.paths.map((p) => p.label ?? "path").join(" / "))})</li>`;
          const req =
            c.op === "eq" ? optLabel(c.field, c.value) :
            c.op === "in" ? c.values.map((v) => optLabel(c.field, v)).join(" or ") :
            c.op === "gte" ? `${formatEUR(c.threshold.amount)} or more` :
            `${c.required.value} points`;
          const field = "field" in c ? c.field : "";
          return `<li><b>${esc(SHORT[field] ?? field)}</b> — needs: ${esc(req)} · you declared: ${esc(optLabel(field, answers[field]))}</li>`;
        });
      return rows.length ? `<ul class="faildetail">${rows.join("")}</ul>` : "";
    }

    function fullCard(r: RouteResult): string {
      return `
        <article class="route">
          <div class="top">
            <div><span class="country">${esc(ds.countries.find((c) => c.code === r.country)?.name ?? r.country)}</span>
              <h3>${esc(r.route.name)}</h3></div>
            <span class="st ${r.status}">${STATUS_LABEL[r.status]}</span>
          </div>
          <p class="why">${whyFor(r)}</p>
          ${r.points ? `<div class="ptsline"><b>Points ${r.points.scored} of ${r.points.required}</b>${
            r.points.items.length ? " — " + r.points.items.map((i) => `${esc(SHORT[i.field] ?? i.field)} +${i.points}`).join(" · ") : ""
          }</div>` : ""}
          ${r.status !== "hold" ? railFor(r) : ""}
          ${r.status === "near" && r.gap_max ? `<div class="gapnote"><b>Gap: up to ${formatEUR(Math.round(r.gap_max))}.</b> A route with a lower threshold may already apply — check the other cards.</div>` : ""}
          ${r.status === "near" && r.gap_points ? `<div class="gapnote"><b>Gap: ${r.gap_points} point${r.gap_points === 1 ? "" : "s"} short.</b> The sourced points table shows where more can come from — language level, experience and age all score.</div>` : ""}
          ${learnBoxFor(r)}
          <div class="foot">${provenanceFor(r)}<a class="next" href="${esc(r.route.info_url)}" rel="noopener">Official page</a></div>
        </article>`;
    }

    function holdRow(r: RouteResult): string {
      const hasUnknown = r.unknown_fields.some((f) => answers[f] !== undefined);
      const why = whyFor(r);
      const short = why.split(". ")[0].replace(/\.$/, "");
      return `
        <details class="route-hold"${hasUnknown ? " open" : ""}>
          <summary><span class="country">${esc(r.country)}</span><span class="hold-name">${esc(r.route.name)}</span><span class="hold-why">${short}</span></summary>
          <div class="hold-body">
            ${r.route.summary ? `<p class="why">${esc(r.route.summary)}</p>` : ""}
            ${failDetail(r)}
            ${learnBoxFor(r)}
            <div class="foot">${provenanceFor(r)}<a class="next" href="${esc(r.route.info_url)}" rel="noopener">Official page</a></div>
          </div>
        </details>`;
    }

    function renderResults() {
      const results = evaluate(ds, answers);
      const met = results.filter((r) => r.status === "met").length;
      const near = results.filter((r) => r.status === "near");

      const nearNote = near.length
        ? near[0].gap_max
          ? ` <b>One is within ${formatEUR(Math.round(near[0].gap_max))}.</b>`
          : near[0].gap_points
            ? ` <b>One is ${near[0].gap_points} point${near[0].gap_points === 1 ? "" : "s"} away.</b>`
            : ""
        : "";
      headline.innerHTML = `${met} route${met === 1 ? "" : "s"} look${met === 1 ? "s" : ""} open.` + nearNote;
      subline.textContent = `Code compared your ${history.length} answer${history.length === 1 ? "" : "s"} against ${results.length} published rule sets. ` +
        `Every value below shows its official quote and the date it was read.`;

      renderDeclaration(null);
      app.dataset.state = "results";

      const byStatus = {
        met: results.filter((r) => r.status === "met"),
        near: results.filter((r) => r.status === "near"),
        hold: results.filter((r) => r.status === "hold"),
      };
      const openUnknowns = byStatus.hold.filter((r) =>
        r.unknown_fields.some((f) => answers[f] !== undefined)).length;

      const strip = `<div class="strip" aria-label="Summary">
          <span class="s-met">${byStatus.met.length} open</span>
          <span class="s-near">${byStatus.near.length} within reach</span>
          <span class="s-hold">${byStatus.hold.length} not yet${openUnknowns ? ` — ${openUnknowns} has an open unknown` : ""}</span>
        </div>`;

      const section = (title: string, cls: string, inner: string, count: number) =>
        count ? `<div class="ghead ${cls}"><b>${title}</b> (${count})</div><div class="stack">${inner}</div>` : "";

      // s3b: counterfactual leverage — what each alternative step would unlock.
      const ups = unlocks(ds, answers);
      const hasOpenSeek = results.some((r) => r.route.kind === "seek" && r.status !== "hold");
      const unlockSection = ups.length
        ? `<div class="ghead unlockh"><b>If your situation changes</b> — what each step unlocks</div>` +
          ups.map((u) => `
            <article class="unlock">
              <h4>With <b>${esc(u.option.short ?? u.option.label)}</b></h4>
              <ul>${u.routes.map((r) =>
                `<li>${esc(r.route.name)} — ${r.status === "met"
                  ? `<b>criteria met</b>`
                  : `<i>within reach${r.gap_max ? ` (${formatEUR(Math.round(r.gap_max))})` : r.gap_points ? ` (${r.gap_points} pts)` : ""}</i>`}</li>`).join("")}
              </ul>
            </article>`).join("") +
          (hasOpenSeek
            ? `<p class="unlock-hint">Your job-search card above is exactly for this: up to a year in Germany, working part-time up to 20h/week, to land that offer.</p>`
            : "")
        : "";

      main.innerHTML = strip +
        section("Open — criteria met", "", byStatus.met.map(fullCard).join(""), byStatus.met.length) +
        section("Within reach", "near", byStatus.near.map(fullCard).join(""), byStatus.near.length) +
        unlockSection +
        section("Not yet", "hold", byStatus.hold.map(holdRow).join(""), byStatus.hold.length);
    }

    restart.addEventListener("click", (e) => {
      e.preventDefault();
      answers = {}; history = [];
      app.dataset.state = "questions";
      headline.innerHTML = introHeadline();
      renderQuestion();
    });

    renderQuestion();
  </script>

  <style is:global>
    *{margin:0;padding:0;box-sizing:border-box}
    body{background:var(--color-bg);color:var(--color-ink);font:var(--text-body);padding:2.8rem 1.2rem 4rem}
    .wrap{max-width:var(--max-content);margin:0 auto}
    :focus-visible{outline:2px solid var(--color-stamp);outline-offset:2px}
    a{color:var(--color-stamp)}

    header{border-bottom:var(--rule-heavy);padding-bottom:1.3rem;margin-bottom:var(--space-5);position:relative}
    .brand{font:var(--text-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--color-muted)}
    h1{font:var(--text-hero);margin:.5rem 0 .4rem;max-width:var(--max-prose)}
    h1 b{color:var(--color-near)}
    .sub{color:var(--color-muted);max-width:38rem;font-size:.92rem}
    .stamp{position:absolute;right:0;top:.2rem;transform:rotate(var(--stamp-rotate));border:var(--stamp-border);color:var(--color-stamp);
      font:600 .68rem var(--font-mono);letter-spacing:.16em;padding:.4rem .7rem;text-transform:uppercase;background:rgba(251,249,242,.6)}
    .stamp b{display:block;font-size:.85rem}

    .cols{display:grid;grid-template-columns:15.5rem 1fr;gap:1.5rem;align-items:start}
    .decl{background:var(--color-card);border:var(--rule-soft);padding:1.1rem 1.2rem;position:sticky;top:1rem}
    .decl h2{font:var(--text-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--color-muted);
      margin-bottom:.6rem;border-bottom:2px solid var(--color-ink);padding-bottom:.4rem}
    .decl dl div{display:flex;justify-content:space-between;gap:.6rem;border-bottom:var(--rule-dotted);padding:.42rem 0}
    .decl dt{color:var(--color-muted);font-size:.78rem}
    .decl dd{font:var(--text-value);text-align:right}
    .decl dd.pending{color:var(--color-muted);font-weight:400}
    .decl .edit{display:inline-block;margin-top:.8rem;font-size:.8rem}
    .decl .edit[hidden]{display:none}

    /* Question mode */
    .qcard{background:var(--color-card);border:var(--rule-soft);border-top:var(--rule-card-top);padding:1.6rem 1.8rem}
    .qmeta{font:var(--text-label);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--color-muted)}
    .qlabel{font:var(--text-route);font-size:1.25rem;margin:.5rem 0 1rem}
    .opts{display:grid;gap:.5rem}
    .opt{font:600 .92rem var(--font-sans);text-align:left;background:var(--color-bg);border:var(--rule-soft);
      padding:.7rem .9rem;cursor:pointer;color:var(--color-ink)}
    .opt:hover{border-color:var(--color-ink);background:var(--color-band-soft)}
    .back{margin-top:1rem;background:none;border:none;color:var(--color-muted);cursor:pointer;font:inherit;font-size:.85rem}

    /* Result summary + groups (s3) */
    .strip{display:flex;gap:.6rem;margin:0 0 .4rem;flex-wrap:wrap}
    .strip span{font:600 .78rem var(--font-sans);letter-spacing:.08em;text-transform:uppercase;padding:.45rem .8rem;border:var(--rule-soft);background:var(--color-card)}
    .strip .s-met{border-left:3px solid var(--color-met);color:var(--color-met)}
    .strip .s-near{border-left:3px solid var(--color-near);color:var(--color-near)}
    .strip .s-hold{border-left:3px solid var(--color-hold);color:var(--color-hold)}
    .ghead{font:700 .74rem var(--font-sans);letter-spacing:.3em;text-transform:uppercase;color:var(--color-muted);
      border-bottom:var(--rule-soft);padding-bottom:.35rem;margin:1.4rem 0 .8rem}
    .ghead b{color:var(--color-met)} .ghead.near b{color:var(--color-near)} .ghead.hold b{color:var(--color-hold)}
    details.route-hold{background:var(--color-card);border:var(--rule-soft);padding:.55rem .9rem}
    details.route-hold summary{cursor:pointer;display:flex;gap:.8rem;align-items:baseline;list-style:none;font-size:.88rem}
    details.route-hold summary::-webkit-details-marker{display:none}
    .hold-name{font:600 .92rem var(--font-serif)}
    .hold-why{color:var(--color-muted);font-size:.8rem;margin-left:auto;text-align:right}
    .hold-body{padding:.6rem 0 .3rem;border-top:var(--rule-dotted);margin-top:.5rem}
    .faildetail{list-style:none;display:grid;gap:.3rem;margin:.5rem 0 .2rem;font-size:.84rem;color:#54513f}
    .faildetail li::before{content:"✗ ";color:var(--color-stamp)}
    .faildetail b{color:var(--color-ink)}
    .ghead.unlockh b{color:var(--color-band)}
    .unlock{background:var(--color-card);border:var(--rule-soft);border-left:3px solid var(--color-band);padding:.85rem 1.05rem;margin-bottom:.7rem}
    .unlock h4{font:600 .95rem var(--font-serif);margin-bottom:.35rem}
    .unlock h4 b{color:var(--color-band)}
    .unlock ul{list-style:none;display:grid;gap:.3rem;font-size:.86rem;color:#54513f}
    .unlock li::before{content:"→ ";color:var(--color-met);font-weight:700}
    .unlock li b{color:var(--color-met)}
    .unlock li i{color:var(--color-near);font-style:normal;font-weight:600}
    .unlock-hint{font-size:.8rem;color:var(--color-muted);margin:-.2rem 0 .4rem;max-width:38rem}
    .learn{font-size:.83rem;background:var(--color-band-soft);border-left:3px solid var(--color-band);padding:.5rem .75rem;margin-top:.55rem;max-width:34rem}
    .learn a{color:var(--color-band);font-weight:600;text-decoration:none}
    .learn a::after{content:" ↗"}

    /* Result cards */
    .stack{display:grid;gap:var(--gap-cards)}
    .route{background:var(--color-card);border:var(--rule-soft);border-top:var(--rule-card-top);padding:var(--pad-card)}
    .top{display:flex;justify-content:space-between;gap:1rem;align-items:baseline}
    .country{font:700 .68rem var(--font-sans);letter-spacing:.22em;text-transform:uppercase;color:var(--color-muted)}
    h3{font:var(--text-route);margin:.15rem 0 .25rem}
    .st{font:700 .66rem var(--font-sans);letter-spacing:.14em;text-transform:uppercase;padding:.3rem .65rem;white-space:nowrap}
    .st.met{background:var(--color-met-soft);color:var(--color-met)}
    .st.near{background:var(--color-near-soft);color:var(--color-near)}
    .st.hold{background:var(--color-hold-soft);color:var(--color-hold)}
    .why{color:#54513f;font-size:.88rem;max-width:var(--max-prose)}

    .rail{margin:.95rem 0 .2rem;max-width:34rem}
    .bar{position:relative;height:var(--rail-h);background:var(--rail-track);border-radius:99px}
    .you{position:absolute;top:0;bottom:0;background:var(--rail-band);border-radius:99px}
    .tick{position:absolute;top:-5px;width:2px;height:17px;background:var(--rail-tick);opacity:.6}
    .lbls{position:relative;height:2.4rem;margin-top:.4rem;font:500 .68rem var(--font-mono)}
    .lbl{position:absolute;transform:translateX(-50%);text-align:center;color:var(--color-muted);line-height:1.35}
    .lbl b{display:block;color:var(--color-ink)}
    .lbl.you-l,.lbl.you-l b{color:var(--color-band)}
    .gapnote{font-size:.85rem;background:var(--color-near-soft);border-left:3px solid var(--color-near);color:#63430f;
      padding:.5rem .75rem;margin-top:.55rem;max-width:34rem}
    .ptsline{font:500 .8rem var(--font-mono);color:var(--color-ink);margin:.5rem 0 .1rem}
    .ptsline b{color:var(--color-met)}

    .foot{display:flex;justify-content:space-between;gap:1rem;align-items:baseline;border-top:var(--rule-dotted);
      margin-top:.85rem;padding-top:.6rem;flex-wrap:wrap}
    .srcs{display:grid;gap:.3rem;flex:1;min-width:16rem}
    .src{font:var(--text-source);color:var(--color-muted)}
    .src b{color:var(--color-met);font-weight:500}
    .next{font:600 .78rem var(--font-sans);text-decoration:none;white-space:nowrap}
    .next::after{content:" ↗"}

    footer{margin-top:var(--space-6);color:var(--color-muted);font-size:.8rem;border-top:var(--rule-heavy);padding-top:.9rem}
    footer p{margin:0}
    .health{margin-top:.6rem;padding-top:.55rem;border-top:var(--rule-dotted);font:var(--text-source);
      display:flex;justify-content:space-between;flex-wrap:wrap;gap:.3rem 1.5rem}

    @media (max-width:760px){
      .cols[data-state="results"]{grid-template-columns:1fr}
      .decl{position:static}
      h1{font-size:1.6rem}
      .stamp{position:static;display:inline-block;margin-top:.8rem}
    }
    @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
  </style>
</body>
</html>
